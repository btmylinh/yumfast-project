         <script>
            document.addEventListener('DOMContentLoaded', function() {
               var logoutBtn = document.getElementById('logout-btn');
               if (logoutBtn) {
                  logoutBtn.addEventListener('click', function(e) {
                     e.preventDefault();
                     localStorage.removeItem('token');
                     window.location.href = '/auth/SignIn';
                  });
               }
            });
         </script>
         <script>
            document.addEventListener('DOMContentLoaded', function () {
               var offcanvas = document.getElementById('offcanvasRight');
               var cartList = document.getElementById('cartList');
               var cartTotal = document.getElementById('cartTotal');
               var btnUpdate = document.getElementById('btnUpdateCart');
               function fmt(n){return '₫'+Number(n||0).toLocaleString('vi-VN');}
               async function loadCart(){
                  try{
                     var res = await fetch('/api/cart');
                     var json = await res.json();
                     var items = json.data || [];
                     cartList.innerHTML = '';
                     if(items.length===0){
                        var li = document.createElement('li');
                        li.className = 'list-group-item py-3 ps-0 text-center text-muted';
                        li.textContent = 'Giỏ hàng trống';
                        cartList.appendChild(li);
                        cartTotal.textContent = fmt(0);
                        return;
                     }
                     for(var i=0;i<items.length;i++){
                        var it = items[i];
                        var li = document.createElement('li');
                        li.className = 'list-group-item py-3 ps-0 border-top';
                        li.dataset.id = String(it.id);
                        li.dataset.key = String(it.key||'');
                        li.innerHTML =
                           '<div class="row align-items-center">'
                           +'<div class="col-6 col-md-6 col-lg-7">'
                           +  '<div class="d-flex">'
                           +    '<img src="'+(it.image||'')+'" alt="" class="icon-shape icon-xxl" onerror="this.src=\'/assets/images/docs/placeholder-img.jpg\'" />'
                           +    '<div class="ms-3">'
                           +      '<h6 class="mb-0">'+(it.name||'')+'</h6>'
                           +      '<div class="mt-2 small lh-1">'
                           +        '<a href="#" class="text-decoration-none text-inherit remove-item">'
                           +          '<span class="me-1 align-text-bottom">'
                           +            '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash-2 text-success">'
                           +              '<polyline points="3 6 5 6 21 6"></polyline>'
                           +              '<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>'
                           +              '<line x1="10" y1="11" x2="10" y2="17"></line>'
                           +              '<line x1="14" y1="11" x2="14" y2="17"></line>'
                           +            '</svg>'
                           +          '</span>'
                           +          '<span class="text-muted">Remove</span>'
                           +        '</a>'
                           +      '</div>'
                           +    '</div>'
                           +  '</div>'
                           +'</div>'
                           +'<div class="col-4 col-md-3 col-lg-3">'
                           +  '<div class="input-group input-spinner">'
                           +    '<input type="button" value="-" class="button-minus btn btn-sm" />'
                           +    '<input type="number" step="1" max="99" min="0" value="'+(it.quantity||1)+'" name="quantity" class="quantity-field form-control-sm form-input" />'
                           +    '<input type="button" value="+" class="button-plus btn btn-sm" />'
                           +  '</div>'
                           +'</div>'
                           +'<div class="col-2 text-lg-end text-start text-md-end col-md-2">'
                           +  '<span class="fw-bold">'+fmt(it.subtotal||0)+'</span>'
                           +'</div>'
                           +'</div>';
                        cartList.appendChild(li);
                     }
                     cartTotal.textContent = fmt(json.total||0);
                     
                     // Cập nhật badge số lượng cho bottom nav và header
                     var totalItems = json.items ? json.items.reduce(function(sum, it){ return sum + (it.quantity||0); }, 0) : 0;
                     var headerBadge = document.getElementById('cartBadge');
                     var bottomBadge = document.getElementById('bottomCartBadge');
                     if(headerBadge){
                        if(totalItems > 0){
                           headerBadge.textContent = totalItems > 99 ? '99+' : totalItems;
                           headerBadge.style.display = '';
                        } else {
                           headerBadge.style.display = 'none';
                        }
                     }
                     if(bottomBadge){
                        if(totalItems > 0){
                           bottomBadge.textContent = totalItems > 99 ? '99+' : totalItems;
                           bottomBadge.style.display = 'flex';
                        } else {
                           bottomBadge.style.display = 'none';
                        }
                     }
                  }catch(e){
                     cartList.innerHTML='';
                     var li = document.createElement('li');
                     li.className = 'list-group-item py-3 ps-0 text-center text-muted';
                     li.textContent = 'Không tải được giỏ hàng';
                     cartList.appendChild(li);
                     cartTotal.textContent = fmt(0);
                     
                     // Reset badges
                     var headerBadge = document.getElementById('cartBadge');
                     var bottomBadge = document.getElementById('bottomCartBadge');
                     if(headerBadge) headerBadge.style.display = 'none';
                     if(bottomBadge) bottomBadge.style.display = 'none';
                  }
               }
               if(offcanvas){ offcanvas.addEventListener('show.bs.offcanvas', loadCart); }
               window.addEventListener('cart:changed', loadCart);
               
               // Load cart ngay khi trang load để hiển thị badge
               loadCart();
               if(btnUpdate){
                  btnUpdate.addEventListener('click', async function(){
                     var rows = cartList.querySelectorAll('li.list-group-item');
                     var payload = [];
                     rows.forEach(function(li){
                        var id = parseInt(li.dataset.id||'0');
                        var key = li.dataset.key||'';
                        var qtyInput = li.querySelector('input[name="quantity"]');
                        var q = parseInt((qtyInput&&qtyInput.value)||'0');
                        if(id>0){ payload.push({ productId:id, optionsKey:key, quantity:q }); }
                     });
                     var res = await fetch('/api/cart/update', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
                     if(res.ok){ loadCart(); }
                  });
               }
               cartList.addEventListener('click', async function(e){
                  var minus = e.target.closest('.button-minus');
                  var plus = e.target.closest('.button-plus');
                  var remove = e.target.closest('.remove-item');
                  if(minus){
                     var li = minus.closest('li.list-group-item');
                     var input = li.querySelector('input[name="quantity"]');
                     var v = Math.max(0, parseInt((input&&input.value)||'0')-1);
                     input.value = v;
                  } else if(plus){
                     var li2 = plus.closest('li.list-group-item');
                     var input2 = li2.querySelector('input[name="quantity"]');
                     var v2 = Math.max(1, parseInt((input2&&input2.value)||'0')+1);
                     input2.value = v2;
                  } else if(remove){
                     e.preventDefault();
                     var li3 = remove.closest('li.list-group-item');
                     var id = parseInt(li3.dataset.id||'0');
                     var key = li3.dataset.key||'';
                     var res = await fetch('/api/cart/update', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify([{ productId:id, optionsKey:key, quantity:0 }]) });
                     if(res.ok){ loadCart(); }
                  }
               });
            });
         </script>
      <style>
