@using System.Globalization
@{
    var currentCulture = CultureInfo.CurrentCulture.Name;
    var isVietnamese = currentCulture.StartsWith("vi");
    var currentLanguageText = isVietnamese ? ViewBag.Vietnamese : ViewBag.English;
}
<!DOCTYPE html>
<html lang="@(isVietnamese ? "vi" : "en")">
<head>
      <!-- Required meta tags -->
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
      <meta name="author" content="YumFast" />
      <meta name="description" content="@(ViewData["Description"] as string ?? "YumFast - Cửa hàng đồ ăn nhanh ngon nhất với giao hàng nhanh chóng trong 30 phút. Đặt món yêu thích: burger, pizza, gà rán, thức ăn nhanh chất lượng cao.")" />
      <meta name="keywords" content="@(ViewData["Keywords"] as string ?? "đồ ăn nhanh, burger, pizza, gà rán, thức ăn nhanh, giao hàng, food delivery, fast food, YumFast")" />
      <meta name="robots" content="index, follow" />
      <meta name="theme-color" content="#198754" />
      
      <!-- Canonical URL -->
      <link rel="canonical" href="@($"https://yumfast.com{Context.Request.Path}{Context.Request.QueryString}")" />
      
      <!-- Open Graph / Facebook -->
      <meta property="og:type" content="website" />
      <meta property="og:url" content="@($"https://yumfast.com{Context.Request.Path}")" />
      <meta property="og:title" content="@($"{ViewData["Title"]} - YumFast")" />
      <meta property="og:description" content="@(ViewData["Description"] as string ?? "YumFast - Cửa hàng đồ ăn nhanh ngon nhất với giao hàng nhanh chóng")" />
      <meta property="og:image" content="@($"https://yumfast.com{ViewData["OgImage"] as string ?? "/assets/images/logo/freshcart-logo.svg"}")" />
      <meta property="og:site_name" content="YumFast" />
      <meta property="og:locale" content="@(isVietnamese ? "vi_VN" : "en_US")" />
      
      <!-- Twitter Card -->
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:url" content="@($"https://yumfast.com{Context.Request.Path}")" />
      <meta name="twitter:title" content="@($"{ViewData["Title"]} - YumFast")" />
      <meta name="twitter:description" content="@(ViewData["Description"] as string ?? "YumFast - Cửa hàng đồ ăn nhanh ngon nhất với giao hàng nhanh chóng")" />
      <meta name="twitter:image" content="@($"https://yumfast.com{ViewData["OgImage"] as string ?? "/assets/images/logo/freshcart-logo.svg"}")" />
      
      <title>@ViewData["Title"] - YumFast</title>
      
      <!-- Preconnect to external domains for performance -->
      <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
      <link rel="preconnect" href="https://www.clarity.ms" crossorigin />
      <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
      <link rel="dns-prefetch" href="https://www.clarity.ms" />
      
      <!-- Preload critical resources -->
      <link rel="preload" href="~/assets/css/theme.min.css" as="style" />
      <link rel="preload" href="~/assets/libs/bootstrap-icons/font/bootstrap-icons.min.css" as="style" />
      <!-- Favicon icon-->
      <link rel="shortcut icon" type="image/x-icon" href="~/assets/images/favicon/favicon.ico" />
      <link rel="apple-touch-icon" href="~/assets/images/favicon/favicon.ico" />

      <!-- Libs CSS -->
      <link href="~/assets/libs/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
      <link href="~/assets/libs/feather-webfont/dist/feather-icons.css" rel="stylesheet" />
      <link href="~/assets/libs/simplebar/dist/simplebar.min.css" rel="stylesheet" />
      <link href="~/assets/libs/tiny-slider/dist/tiny-slider.css" rel="stylesheet" />
      <link href="~/assets/libs/slick-carousel/slick/slick.css" rel="stylesheet" />
      <link href="~/assets/libs/slick-carousel/slick/slick-theme.css" rel="stylesheet" />

      <!-- Theme CSS -->
      <link rel="stylesheet" href="~/assets/css/theme.min.css" />
      @RenderSection("Styles", required: false)
      
      <!-- Structured Data (JSON-LD) -->
      <script type="application/ld+json">
      {
        "@@context": "https://schema.org",
        "@@type": "Restaurant",
        "name": "YumFast",
        "description": "Cửa hàng đồ ăn nhanh ngon nhất với giao hàng nhanh chóng trong 30 phút",
        "url": "https://yumfast.com",
        "logo": "https://yumfast.com/assets/images/logo/freshcart-logo.svg",
        "image": "https://yumfast.com/assets/images/logo/freshcart-logo.svg",
        "address": {
          "@@type": "PostalAddress",
          "addressCountry": "VN"
        },
        "servesCuisine": ["Fast Food", "Vietnamese Food"],
        "priceRange": "$$",
        "telephone": "1900-1234",
        "openingHours": "Mo-Su 08:00-22:00"
      }
      </script>
      
      <!-- Analytics - Defer loading for better performance -->
      <script defer src="https://www.googletagmanager.com/gtag/js?id=G-M8S4MT3EYG"></script>
      <script>
         window.dataLayer = window.dataLayer || [];
         function gtag() {
            dataLayer.push(arguments);
         }
         gtag("js", new Date());
         gtag("config", "G-M8S4MT3EYG");
      </script>
      <script defer type="text/javascript">
         (function (c, l, a, r, i, t, y) {
            c[a] =
               c[a] ||
               function () {
                  (c[a].q = c[a].q || []).push(arguments);
               };
            t = l.createElement(r);
            t.async = 1;
            t.src = "https://www.clarity.ms/tag/" + i;
            y = l.getElementsByTagName(r)[0];
            y.parentNode.insertBefore(t, y);
         })(window, document, "clarity", "script", "kuc8w5o9nt");
      </script>
   </head>

   <body>
      <!-- navigation -->
      <header>
         <div class="container">
            <!-- Tầng 1: Utility Bar (ẩn trên mobile, gom vào menu) -->
            <div class="row align-items-center pt-2 d-none d-md-flex">
               <div class="col-xl-3 col-lg-8 d-flex">
                  <div class="dropdown selectBox">
                     <a class="dropdown-toggle selectValue text-reset" href="javascript:void(0)" data-bs-toggle="dropdown" aria-expanded="false">@ViewBag.VndCurrency</a>
                     <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="javascript:void(0)">@ViewBag.VndCurrency</a></li>
                        <li><a class="dropdown-item" href="javascript:void(0)">@ViewBag.UsdCurrency</a></li>
                     </ul>
                  </div>
                  <div class="ms-6">
                     <div class="dropdown selectBox">
                        <a class="dropdown-toggle selectValue text-reset" href="javascript:void(0)" data-bs-toggle="dropdown" aria-expanded="false">@currentLanguageText</a>
                        <ul class="dropdown-menu">
                           <li>
                              <form asp-controller="Home" asp-action="SetLanguage" method="post" style="display: inline;">
                                 <input name="culture" value="vi-VN" type="hidden" />
                                 <input name="returnUrl" value="@Context.Request.Path" type="hidden" />
                                 <button type="submit" class="dropdown-item border-0 bg-transparent @(isVietnamese ? "active" : "")">@ViewBag.Vietnamese</button>
                              </form>
                           </li>
                           <li>
                              <form asp-controller="Home" asp-action="SetLanguage" method="post" style="display: inline;">
                                 <input name="culture" value="en-US" type="hidden" />
                                 <input name="returnUrl" value="@Context.Request.Path" type="hidden" />
                                 <button type="submit" class="dropdown-item border-0 bg-transparent @(!isVietnamese ? "active" : "")">@ViewBag.English</button>
                              </form>
                           </li>
                        </ul>
                     </div>
                  </div>
               </div>
               <div class="col-xl-9 col-lg-4 d-flex align-items-center justify-content-end">
                  <a href="#" class="text-reset small">@ViewBag.Support</a>
                  <a href="#" class="mx-md-8 ms-4 text-reset small">@ViewBag.Delivery</a>
                  <a href="#" class="text-reset small d-none d-xl-block">@ViewBag.Warranty</a>
               </div>
            </div>
            
            <!-- Tầng 2: Main Header (Mobile-first) -->
            <div class="row align-items-center pt-3 pt-md-6 pb-3 pb-md-4 mt-2 mt-md-4 mt-lg-0">
               <!-- Logo - Mobile: center, Desktop: left -->
               <div class="col-6 col-md-3 col-xl-2 mb-3 mb-md-0 text-center text-md-start">
                  <a href="@Url.Action("Index", "Home")" class="d-inline-block">
                     <img src="~/assets/images/logo/freshcart-logo.svg" alt="YumFast" class="img-fluid" style="max-height: 40px;" />
                  </a>
               </div>

               <!-- Search Bar - Full width trên mobile -->
               <div class="col-12 col-md-6 col-lg-6 col-xl-5 order-3 order-md-2 mb-3 mb-md-0" x-data="advancedSearch()" x-init="init()">
                  <form @@submit.prevent="performSearch()">
                     <div class="input-group position-relative">
                        <input 
                           class="form-control" 
                           type="search" 
                           placeholder="@ViewBag.SearchForProducts" 
                           aria-label="@ViewBag.SearchForProducts" 
                           aria-describedby="button-addon2"
                           x-model="query"
                           @@input.debounce.300ms="loadSuggestions()"
                           @@focus="showSuggestions = true"
                           @@blur="setTimeout(() => showSuggestions = false, 200)"
                           @@keydown.arrow-down.prevent="navigateSuggestions(1)"
                           @@keydown.arrow-up.prevent="navigateSuggestions(-1)"
                           @@keydown.enter.prevent="selectSuggestion(suggestions[selectedIndex])"
                           autocomplete="off" />
                        <button class="btn btn-primary" type="submit" id="button-addon2">
                           <span class="d-none d-sm-inline">@ViewBag.Search</span>
                           <i class="bi bi-search d-sm-none"></i>
                        </button>
                        
                        <!-- Autocomplete Dropdown -->
                        <div 
                           class="position-absolute top-100 start-0 w-100 bg-white border rounded shadow-lg mt-1 z-1000"
                           x-show="showSuggestions && (suggestions.length > 0 || popularSearches.length > 0)"
                           x-transition
                           style="max-height: 400px; overflow-y: auto; display: none; z-index: 1050;">
                           <!-- Suggestions -->
                           <template x-if="suggestions.length > 0">
                              <div>
                                 <div class="px-3 py-2 bg-light border-bottom">
                                    <small class="text-muted fw-bold">Gợi ý</small>
                                 </div>
                                 <template x-for="(item, index) in suggestions" :key="item.id">
                                    <a 
                                       href="#" 
                                       class="d-block px-3 py-2 text-decoration-none text-dark"
                                       :class="{ 'bg-light': index === selectedIndex }"
                                       @@mouseenter="selectedIndex = index"
                                       @@click.prevent="selectSuggestion(item)">
                                       <div class="d-flex align-items-center">
                                          <img :src="item.image" alt="" class="me-2" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;" />
                                          <div class="flex-grow-1">
                                             <div class="fw-medium" x-text="item.name"></div>
                                             <small class="text-muted" x-text="item.category"></small>
                                          </div>
                                          <div class="text-end">
                                             <div class="fw-bold text-primary" x-text="formatPrice(item.price)"></div>
                                          </div>
                                       </div>
                                    </a>
                                 </template>
                              </div>
                           </template>
                           
                           <!-- Popular Searches -->
                           <template x-if="suggestions.length === 0 && popularSearches.length > 0 && query.length === 0">
                              <div>
                                 <div class="px-3 py-2 bg-light border-bottom">
                                    <small class="text-muted fw-bold">Tìm kiếm phổ biến</small>
                                 </div>
                                 <template x-for="(term, index) in popularSearches" :key="index">
                                    <a 
                                       href="#" 
                                       class="d-block px-3 py-2 text-decoration-none text-dark"
                                       @@click.prevent="query = term; performSearch()">
                                       <i class="bi bi-clock-history me-2 text-muted"></i>
                                       <span x-text="term"></span>
                                    </a>
                                 </template>
                              </div>
                           </template>
                           
                           <!-- No Results -->
                           <template x-if="suggestions.length === 0 && query.length >= 2">
                              <div class="px-3 py-3 text-center text-muted">
                                 <small>Không tìm thấy kết quả</small>
                              </div>
                           </template>
                        </div>
                     </div>
                  </form>
               </div>
               
               <!-- Right Actions: Cart + Menu (Mobile) hoặc Cart + Account + Notifications (Desktop) -->
               <div class="col-6 col-md-3 col-lg-3 col-xl-5 order-2 order-md-3 d-flex align-items-center justify-content-end gap-2 gap-md-3">
                  <!-- Cart Icon - Luôn hiển thị -->
                  <div class="text-center d-lg-flex align-items-center gap-3 ms-2">
                     <a data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight" href="#offcanvasExample" role="button" aria-controls="offcanvasRight" class="text-reset position-relative">
                        <i class="bi bi-cart2 fs-4"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="cartBadge" style="font-size: 0.65rem; display: none;">0</span>
                        <p class="mb-0 d-none d-xl-block small mt-1">@ViewBag.ShoppingCart</p>
                     </a>
                  </div>
                  
                  <!-- Desktop: Account + Notifications -->
                  <div class="d-none d-lg-flex align-items-center gap-3 ms-2">
                     <div class="text-center">
                        <div class="dropdown">
                           <a href="#" class="text-reset" data-bs-toggle="dropdown" aria-expanded="false">
                              <div class="lh-1">
                                 <div class="position-relative d-inline-block mb-2">
                                    <i class="bi bi-bell fs-4"></i>
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                       1
                                       <span class="visually-hidden">unread messages</span>
                                    </span>
                                 </div>
                                 <p class="mb-0 d-none d-xl-block small">@ViewBag.Notification</p>
                              </div>
                           </a>
                           <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end p-0">
                              <div>
                                 <h6 class="px-4 border-bottom py-3 mb-0">@ViewBag.Notification</h6>
                                 <p class="mb-0 px-4 py-3">
                                    <a href="#">@ViewBag.SignIn</a>
                                    or
                                    <a href="#">@ViewBag.SignUp</a>
                                    in or so you don t have to enter your details every time
                                 </p>
                              </div>
                           </div>
                        </div>
                     </div>
                     
                     <!-- Account Dropdown -->
                     <div class="text-center dropdown">
                        <a href="#" class="text-reset" data-bs-toggle="dropdown" aria-expanded="false">
                           <div class="lh-1">
                              <div class="mb-2">
                                 <i class="bi bi-person-circle fs-4"></i>
                              </div>
                              <p class="mb-0 d-none d-xl-block small" id="headerAccountLabel">@ViewBag.Account</p>
                           </div>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                           <li><a class="dropdown-item" id="menuSignIn" href="/auth/SignIn">@ViewBag.SignIn</a></li>
                           <li><a class="dropdown-item" id="menuSignUp" href="/auth/SignUp">@ViewBag.SignUp</a></li>
                           <li><hr class="dropdown-divider"></li>
                           <li><a class="dropdown-item" id="menuDashboard" href="/dashboard">Dashboard</a></li>
                           <li><a class="dropdown-item" id="menuProfile" href="/user/profile">@ViewBag.Profile</a></li>
                           <li><a class="dropdown-item" id="menuSettings" href="/user/settings">@ViewBag.Settings</a></li>
                           <li><hr class="dropdown-divider"></li>
                           <li><a class="dropdown-item" href="/Order/MyOrders"><i class="bi bi-archive me-2"></i>@ViewBag.MyOrders</a></li>
                           <li><hr class="dropdown-divider"></li>
                           <li>
                              <a class="dropdown-item" href="#" id="logout-btn">
                              <i class="feather-icon icon-log-out me-2"></i>
                                 @ViewBag.SignOut
                              </a>
                           </li>
                        </ul>
                     </div>
                              </div>
                  
                  <!-- Mobile: Hamburger Menu Button -->
                  <div class="d-lg-none">
                     <button class="btn btn-link text-reset p-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#navbar-default" aria-controls="navbar-default">
                        <i class="bi bi-list fs-3"></i>
                        <span class="visually-hidden">Menu</span>
                     </button>
                           </div>
                     </div>
            </div>
         </div>
      </header>

      <nav class="navbar navbar-expand-lg navbar-light navbar-default p-0 p-sm-0 navbar-offcanvas-color" aria-label="Offcanvas navbar large">
         <div class="container">
            <div class="offcanvas offcanvas-start" tabindex="-1" id="navbar-default" aria-labelledby="navbar-defaultLabel">
               <div class="offcanvas-header pb-1 border-bottom">
                  <a href="@Url.Action("Index", "Home")" class="d-inline-block">
                     <img src="~/assets/images/logo/freshcart-logo.svg" alt="YumFast" style="max-height: 35px;" />
                  </a>
                  <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
               </div>
               <div class="offcanvas-body p-0">
                  <!-- Mobile Menu: Account Section (nếu đã đăng nhập) -->
                  <div class="d-lg-none border-bottom p-3 bg-light" id="mobileAccountSection" style="display: none;">
                     <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-person-circle fs-2 text-muted me-3"></i>
                        <div class="flex-grow-1">
                           <p class="mb-0 fw-bold" id="mobileUserName">@ViewBag.Account</p>
                           <small class="text-muted" id="mobileUserEmail"></small>
                                    </div>
                                    </div>
                     <div class="d-grid gap-2">
                        <a href="/Order/MyOrders" class="btn btn-outline-primary btn-sm">
                           <i class="bi bi-archive me-2"></i>@ViewBag.MyOrders
                        </a>
                        <a href="/user/profile" class="btn btn-outline-secondary btn-sm" id="mobileProfileBtn" style="display: none;">
                           <i class="bi bi-person me-2"></i>@ViewBag.Profile
                        </a>
                        <a href="#" class="btn btn-outline-danger btn-sm" id="mobileLogoutBtn" style="display: none;">
                           <i class="bi bi-box-arrow-right me-2"></i>@ViewBag.SignOut
                        </a>
                        <div class="d-grid gap-2" id="mobileSignInSection">
                           <a href="/auth/SignIn" class="btn btn-primary btn-sm">@ViewBag.SignIn</a>
                           <a href="/auth/SignUp" class="btn btn-outline-primary btn-sm">@ViewBag.SignUp</a>
                                    </div>
                                    </div>
                     <!-- Mobile: Currency & Language -->
                     <hr class="my-3">
                     <div class="d-flex gap-2">
                        <div class="dropdown flex-grow-1">
                           <button class="btn btn-outline-secondary btn-sm w-100" type="button" data-bs-toggle="dropdown">
                              <span id="mobileCurrency">@ViewBag.VndCurrency</span>
                           </button>
                           <ul class="dropdown-menu">
                              <li><a class="dropdown-item" href="javascript:void(0)">@ViewBag.VndCurrency</a></li>
                              <li><a class="dropdown-item" href="javascript:void(0)">@ViewBag.UsdCurrency</a></li>
                                       </ul>
                                    </div>
                        <div class="dropdown flex-grow-1">
                           <button class="btn btn-outline-secondary btn-sm w-100" type="button" data-bs-toggle="dropdown">
                              <span id="mobileLanguage">@currentLanguageText</span>
                           </button>
                           <ul class="dropdown-menu">
                              <li>
                                 <form asp-controller="Home" asp-action="SetLanguage" method="post" style="display: inline;">
                                    <input name="culture" value="vi-VN" type="hidden" />
                                    <input name="returnUrl" value="@Context.Request.Path" type="hidden" />
                                    <button type="submit" class="dropdown-item border-0 bg-transparent w-100 text-start @(isVietnamese ? "active" : "")">@ViewBag.Vietnamese</button>
                                 </form>
                                          </li>
                                          <li>
                                 <form asp-controller="Home" asp-action="SetLanguage" method="post" style="display: inline;">
                                    <input name="culture" value="en-US" type="hidden" />
                                    <input name="returnUrl" value="@Context.Request.Path" type="hidden" />
                                    <button type="submit" class="dropdown-item border-0 bg-transparent w-100 text-start @(!isVietnamese ? "active" : "")">@ViewBag.English</button>
                                 </form>
                                          </li>
                                       </ul>
                                    </div>
                                 </div>
                                    </div>

                                    <div>
                     <ul class="navbar-nav align-items-start flex-wrap">
                        
                        <li class="nav-item ">
                           <a class="nav-link " href="@Url.Action("Index", "Home")" role="button">@ViewBag.Home</a>
                        </li>
                        <li class="nav-item">
                           <a class="nav-link" href="@Url.Action("Index","Shop") " role="button">@ViewBag.Shop</a>
                        </li>

                     </ul>
                  </div>
               </div>
            </div>
         </div>
      </nav>

      <!-- Shop Cart -->

      <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel">
         <div class="offcanvas-header border-bottom">
            <div class="text-start">
               <h5 id="offcanvasRightLabel" class="mb-0 fs-4">@ViewBag.ShopCart</h5>
               <small>Location in 382480</small>
            </div>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
         </div>
         <div class="offcanvas-body">
            <div>
               <ul id="cartList" class="list-group list-group-flush"></ul>
               <div class="d-flex justify-content-between mt-3">
                  <span class="fw-semibold">Tổng</span>
                  <span id="cartTotal" class="fw-bold">₫0</span>
               </div>
               <div class="d-grid gap-2 mt-4">
                  <a href="/Checkout/Payment" class="btn btn-primary btn-lg">
                     <i class="bi bi-credit-card me-2"></i>Đặt hàng ngay
                  </a>
                  <a href="#" id="btnUpdateCart" class="btn btn-outline-dark">Cập nhật giỏ hàng</a>
               </div>
            </div>
         </div>
      </div>
      <!-- Modal -->
      <div class="modal fade" id="userModal" tabindex="-1" aria-labelledby="userModalLabel" aria-hidden="true">
         <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-4">
               <div class="modal-header border-0">
                  <h5 class="modal-title fs-3 fw-bold" id="userModalLabel">Sign Up</h5>

                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
               </div>
               <div class="modal-body">
                  <form>
                     <div class="mb-3">
                        <label for="fullName" class="form-label">Name</label>
                        <input type="text" class="form-control" id="fullName" placeholder="Enter Your Name" required="" />
                     </div>
                     <div class="mb-3">
                        <label for="email" class="form-label">Email address</label>
                        <input type="email" class="form-control" id="email" placeholder="Enter Email address" required="" />
                     </div>

                     <div class="mb-5">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" class="form-control" id="password" placeholder="Enter Password" required="" />
                        <small class="form-text">
                           By Signup, you agree to our
                           <a href="javascript:void(0)">Terms of Service</a>
                           &
                           <a href="javascript:void(0)">Privacy Policy</a>
                        </small>
                     </div>

                     <button type="submit" class="btn btn-primary">Sign Up</button>
                  </form>
               </div>
               <div class="modal-footer border-0 justify-content-center">
                  Already have an account?
                  <a href="#">Sign in</a>
               </div>
            </div>
         </div>
      </div>

