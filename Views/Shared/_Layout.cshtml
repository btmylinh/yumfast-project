      <script>
        document.addEventListener('DOMContentLoaded', function(){
          try {
            var token = localStorage.getItem('token') || localStorage.getItem('auth_token');
            var user = null; try { user = JSON.parse(localStorage.getItem('current_user')||'null'); } catch {}
            var displayName = (user && (user.name || user.fullName || user.email)) || '';
            var email = (user && user.email) || '';
            
            // Desktop header elements
            var label = document.getElementById('headerAccountLabel');
            var signIn = document.getElementById('menuSignIn');
            var signUp = document.getElementById('menuSignUp');
            var logout = document.getElementById('logout-btn');
            var profile = document.getElementById('menuProfile');
            var settings = document.getElementById('menuSettings');
            
            // Mobile menu elements
            var mobileAccountSection = document.getElementById('mobileAccountSection');
            var mobileUserName = document.getElementById('mobileUserName');
            var mobileUserEmail = document.getElementById('mobileUserEmail');
            var mobileProfileBtn = document.getElementById('mobileProfileBtn');
            var mobileLogoutBtn = document.getElementById('mobileLogoutBtn');
            var mobileSignInSection = document.getElementById('mobileSignInSection');
            
            if (token) {
              // Desktop: Update account label
              if (label && displayName) label.textContent = displayName;
              if (signIn) signIn.style.display = 'none';
              if (signUp) signUp.style.display = 'none';
              if (logout) logout.style.display = '';
              if (profile) profile.style.display = '';
              if (settings) settings.style.display = '';
              
              // Mobile: Show account section
              if (mobileAccountSection) {
                mobileAccountSection.style.display = 'block';
              }
              if (mobileUserName && displayName) {
                mobileUserName.textContent = displayName;
              }
              if (mobileUserEmail && email) {
                mobileUserEmail.textContent = email;
              }
              if (mobileProfileBtn) {
                mobileProfileBtn.style.display = '';
              }
              if (mobileLogoutBtn) {
                mobileLogoutBtn.style.display = '';
              }
              if (mobileSignInSection) {
                mobileSignInSection.style.display = 'none';
              }
            } else {
              // Desktop: Show sign in/up
              if (label) label.textContent = '@ViewBag.Account';
              if (signIn) signIn.style.display = '';
              if (signUp) signUp.style.display = '';
              if (logout) logout.style.display = 'none';
              if (profile) profile.style.display = 'none';
              if (settings) settings.style.display = 'none';
              
              // Mobile: Hide account section, show sign in/up
              if (mobileAccountSection) {
                mobileAccountSection.style.display = 'block'; // Still show section but with sign in buttons
              }
              if (mobileUserName) {
                mobileUserName.textContent = '@ViewBag.Account';
              }
              if (mobileUserEmail) {
                mobileUserEmail.textContent = '';
              }
              if (mobileProfileBtn) {
                mobileProfileBtn.style.display = 'none';
              }
              if (mobileLogoutBtn) {
                mobileLogoutBtn.style.display = 'none';
              }
              if (mobileSignInSection) {
                mobileSignInSection.style.display = 'grid';
              }
            }
            
            // Dashboard visibility check
            const dash = document.getElementById('menuDashboard');
            if (token && dash) {
              fetch('/api/user/is-admin', { headers: { 'Authorization': 'Bearer ' + token } })
                .then(async (r)=>{ let j=null; try{ j=await r.json(); }catch{}; if(!r.ok || !j || !j.isAdmin){ dash.style.display='none'; } else { dash.style.display=''; } })
                .catch(()=>{ if(dash) dash.style.display='none'; });
            } else { if(dash) dash.style.display='none'; }
            
            // Logout handlers
            if (logout) {
              logout.addEventListener('click', function(e){
                e.preventDefault();
                try { localStorage.removeItem('token'); localStorage.removeItem('auth_token'); localStorage.removeItem('current_user'); } catch {}
                window.location.href = '/auth/SignIn';
              });
            }
            if (mobileLogoutBtn) {
              mobileLogoutBtn.addEventListener('click', function(e){
                e.preventDefault();
                try { localStorage.removeItem('token'); localStorage.removeItem('auth_token'); localStorage.removeItem('current_user'); } catch {}
                window.location.href = '/auth/SignIn';
              });
            }
          } catch (e) { console.warn('Header UI init failed', e); }
        });
      </script>
