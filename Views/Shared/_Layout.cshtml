      <div x-data="chatWidget()" x-on:keydown.escape.window="open=false" x-init="init()">
        <button class="btn btn-primary chat-fab" x-show="!open" x-on:click="open = !open">@((string.Equals(ViewBag.ChatTitle as string, "chat_title") || string.IsNullOrWhiteSpace(ViewBag.ChatTitle as string)) ? "Tư vấn" : ViewBag.ChatTitle)</button>
        <div class="card shadow chat-panel" x-show="open" x-transition x-cloak>
          <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@((string.Equals(ViewBag.ChatTitle as string, "chat_title") || string.IsNullOrWhiteSpace(ViewBag.ChatTitle as string)) ? "Tư vấn" : ViewBag.ChatTitle)</strong>
            <button type="button" class="btn btn-sm btn-outline-secondary" x-on:click.stop="open=false" aria-label="Đóng">×</button>
          </div>
          <div class="card-body">
            <div class="mb-2" x-html="welcome"></div>
            <template x-for="m in msgs">
              <div class="mb-2">
                <div :class="m.role==='user' ? 'text-end' : 'text-start'">
                  <div :class="m.role==='user' ? 'chat-bubble-user' : 'chat-bubble-bot'" x-text="m.text"></div>
                </div>
                <template x-if="m.items && m.items.length">
                  <div class="mt-2">
                    <template x-for="p in m.items">
                      <div class="border rounded p-2 mb-2">
                        <div class="fw-bold" x-text="p.name"></div>
                        <div>₫<span x-text="formatPrice(p.price)"></span></div>
                        <div class="mt-1 d-flex gap-2">
                          <a class="btn btn-sm btn-outline-secondary" :href="'/product/detail/'+p.id">@Html.Raw(ViewBag.ViewDetails)</a>
                          <button class="btn btn-sm btn-primary btn-add-cart" :data-id="p.id">@ViewBag.AddToCart</button>
                        </div>
                      </div>
                    </template>
                  </div>
                </template>
                <template x-if="m.coupons && m.coupons.length">
                  <div class="mt-1">
                    <div class="small text-muted">Mã giảm giá:</div>
                    <template x-for="c in m.coupons">
                      <div class="border rounded p-2 mb-1 d-flex justify-content-between align-items-center">
                        <div>
                          <div class="fw-bold" x-text="c.code"></div>
                          <div class="small" x-text="c.name"></div>
                        </div>
                        <div class="text-end">
                          <span class="badge bg-success" x-text="c.type===1 ? (c.value+'%') : ('₫'+formatPrice(c.value))"></span>
                          <div class="small text-muted">Còn lại: <span x-text="c.remaining"></span></div>
                        </div>
                      </div>
                    </template>
                  </div>
                </template>
              </div>
            </template>
          </div>
          <div class="card-footer">
            <div class="input-group">
              <input type="text" class="form-control" placeholder="@((string.Equals(ViewBag.ChatPlaceholder as string, "chat_placeholder") || string.IsNullOrWhiteSpace(ViewBag.ChatPlaceholder as string)) ? "Nhập câu hỏi..." : ViewBag.ChatPlaceholder)" x-model="input" x-on:keydown.enter.prevent="send()">
              <button class="btn btn-primary" x-on:click="send()">@((string.Equals(ViewBag.ChatSend as string, "chat_send") || string.IsNullOrWhiteSpace(ViewBag.ChatSend as string)) ? "Gửi" : ViewBag.ChatSend)</button>
            </div>
          </div>
        </div>
      </div>
      <script>
        (function(){
          var btn = document.querySelector('.chat-fab');
          var panel = document.querySelector('.chat-panel');
          var closeBtn = panel ? panel.querySelector('.btn-outline-secondary') : null;
          var sendBtn = panel ? panel.querySelector('.card-footer .btn.btn-primary') : null;
          var inputEl = panel ? panel.querySelector('.card-footer input.form-control') : null;
          var bodyEl = panel ? panel.querySelector('.card-body') : null;
          function alpineReady(){ try{ return !!window.Alpine; }catch(_){ return false; } }
          if(btn && panel){
            btn.addEventListener('click', function(){
              if(alpineReady()) return;
              panel.removeAttribute('x-cloak');
              panel.style.display = 'block';
            });
          }
          if(closeBtn && panel){
            closeBtn.addEventListener('click', function(){
              if(alpineReady()) return;
              panel.style.display = 'none';
            });
          }
          if(sendBtn && inputEl && bodyEl){
            function append(role, text){
              var wrap = document.createElement('div');
              wrap.className = 'mb-2';
              var inner = document.createElement('div');
              inner.className = role==='user' ? 'text-end' : 'text-start';
              var bubble = document.createElement('div');
              bubble.className = role==='user' ? 'chat-bubble-user' : 'chat-bubble-bot';
              bubble.textContent = text;
              inner.appendChild(bubble);
              wrap.appendChild(inner);
              bodyEl.appendChild(wrap);
              bodyEl.scrollTop = bodyEl.scrollHeight;
            }
            function doSend(){
              if(alpineReady()) return;
              var t = (inputEl.value||'').trim();
              if(!t) return;
              append('user', t);
              inputEl.value = '';
              fetch('/api/chat',{ method:'POST', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify({ text:t }) })
                .then(function(r){ return r.json(); })
                .then(function(j){ append('bot', (j&&j.reply)||''); })
                .catch(function(){ append('bot','Lỗi kết nối máy chủ, vui lòng thử lại.'); });
            }
            sendBtn.addEventListener('click', doSend);
            inputEl.addEventListener('keydown', function(e){ if(e.key==='Enter'){ e.preventDefault(); doSend(); } });
          }
          window.addEventListener('keydown', function(e){
            if(e.key === 'Escape'){
              if(alpineReady()) return;
              if(panel) panel.style.display = 'none';
            }
          });
        })();
      </script>
