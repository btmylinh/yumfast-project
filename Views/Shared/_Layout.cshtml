      <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
      <script>
        // Order Tracking Card - Auto load và realtime update
        (function() {
          var trackingContainer = document.getElementById('orderTrackingContainer');
          if (!trackingContainer) return;
          
          var currentOrderId = null;
          var signalRConnection = null;
          
          // Load active order và hiển thị card
          async function loadActiveOrder() {
            try {
              var token = localStorage.getItem('token') || localStorage.getItem('auth_token');
              if (!token) {
                trackingContainer.style.display = 'none';
                return;
              }
              
              var response = await fetch('/api/orders/active', {
                headers: { 'Authorization': 'Bearer ' + token }
              });
              
              if (response.status === 401) {
                trackingContainer.style.display = 'none';
                return;
              }
              
              if (!response.ok) {
                console.warn('Failed to load active order');
                trackingContainer.style.display = 'none';
                return;
              }
              
              var result = await response.json();
              if (!result.success || !result.data) {
                trackingContainer.style.display = 'none';
                return;
              }
              
              var order = result.data;
              currentOrderId = order.orderId;
              
              // Chỉ hiển thị nếu status != 4 (Hoàn thành) và != 5 (Đã hủy)
              if (order.status === 4 || order.status === 5 || order.status === 6) {
                trackingContainer.style.display = 'none';
                return;
              }
              
              // Load card HTML
              await loadTrackingCard(order.orderId);
              
              // Setup SignalR để cập nhật realtime
              setupSignalR(order.orderId);
              
            } catch (error) {
              console.error('Load active order error:', error);
              trackingContainer.style.display = 'none';
            }
          }
          
          // Load tracking card HTML
          async function loadTrackingCard(orderId) {
            try {
              var token = localStorage.getItem('token') || localStorage.getItem('auth_token');
              var response = await fetch('/Order/GetTrackingCard/' + orderId, {
                headers: token ? { 'Authorization': 'Bearer ' + token } : {},
                credentials: 'include' // Include cookies for Cookie authentication
              });
              
              if (!response.ok) {
                console.warn('Failed to load tracking card');
                return;
              }
              
              var html = await response.text();
              trackingContainer.innerHTML = html;
              trackingContainer.style.display = 'block';
              
              // Re-initialize any card-specific scripts if needed
            } catch (error) {
              console.error('Load tracking card error:', error);
            }
          }
          
          // Setup SignalR connection
          function setupSignalR(orderId) {
            if (typeof signalR === 'undefined') {
              console.warn('SignalR not loaded');
              return;
            }
            
            if (signalRConnection) {
              signalRConnection.stop();
            }
            
            signalRConnection = new signalR.HubConnectionBuilder()
              .withUrl('/hubs/order')
              .withAutomaticReconnect()
              .build();
            
            // Listen for order status updates
            signalRConnection.on('OrderStatusUpdated', function(data) {
              if (data.orderId === orderId || data.orderId === currentOrderId) {
                console.log('Order status updated:', data);
                // Reload card
                loadTrackingCard(data.orderId || currentOrderId);
                
                // Nếu đơn đã hoàn thành hoặc hủy, ẩn card
                if (data.status === 4 || data.status === 5 || data.status === 6) {
                  setTimeout(function() {
                    trackingContainer.style.display = 'none';
                    if (signalRConnection) {
                      signalRConnection.stop();
                      signalRConnection = null;
                    }
                  }, 2000); // Hiển thị thông báo 2s rồi ẩn
                }
              }
            });
            
            signalRConnection.on('OrderCancelled', function(data) {
              if (data.orderId === orderId || data.orderId === currentOrderId) {
                trackingContainer.style.display = 'none';
                if (signalRConnection) {
                  signalRConnection.stop();
                  signalRConnection = null;
                }
              }
            });
            
            signalRConnection.start()
              .then(function() {
                console.log('SignalR connected for order tracking');
                // Join order group
                if (orderId) {
                  signalRConnection.invoke('JoinOrderGroup', orderId).catch(function(err) {
                    console.warn('Failed to join order group:', err);
                  });
                }
              })
              .catch(function(err) {
                console.error('SignalR connection error:', err);
              });
          }
          
          // Polling fallback nếu SignalR không hoạt động
          var pollInterval = null;
          function startPolling() {
            if (pollInterval) return;
            pollInterval = setInterval(function() {
              if (currentOrderId) {
                loadTrackingCard(currentOrderId);
              }
            }, 10000); // Poll mỗi 10 giây
          }
          
          function stopPolling() {
            if (pollInterval) {
              clearInterval(pollInterval);
              pollInterval = null;
            }
          }
          
          // Initialize khi DOM ready
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
              loadActiveOrder();
              startPolling();
            });
          } else {
            loadActiveOrder();
            startPolling();
          }
          
          // Cleanup khi page unload
          window.addEventListener('beforeunload', function() {
            stopPolling();
            if (signalRConnection) {
              signalRConnection.stop();
            }
          });
        })();
      </script>
      <script>
        function advancedSearch(){
          return {
            query: '',
            suggestions: [],
            popularSearches: [],
            showSuggestions: false,
            selectedIndex: -1,
            loading: false,
            
            init(){
              this.loadPopularSearches();
            },
            
            formatPrice(v){
              try{
                return new Intl.NumberFormat('vi-VN', {style:'currency', currency:'VND'}).format(v);
              }catch{
                return String(v);
              }
            },
            
            async loadSuggestions(){
              if(this.query.length < 2){
                this.suggestions = [];
                return;
              }
              
              this.loading = true;
              try{
                const r = await fetch(`/api/products/autocomplete?q=${encodeURIComponent(this.query)}&limit=8`);
                if(r.ok){
                  const j = await r.json();
                  this.suggestions = j.suggestions || [];
                  this.selectedIndex = -1;
                }
              }catch(e){
                console.error('Load suggestions error:', e);
                this.suggestions = [];
              }finally{
                this.loading = false;
              }
            },
            
            async loadPopularSearches(){
              // Load từ localStorage hoặc API
              try{
                const stored = localStorage.getItem('popular_searches');
                if(stored){
                  this.popularSearches = JSON.parse(stored).slice(0, 5);
                }
              }catch{
                this.popularSearches = ['burger', 'gà rán', 'pizza', 'nước ngọt', 'khoai tây chiên'];
              }
            },
            
            navigateSuggestions(direction){
              if(this.suggestions.length === 0) return;
              this.selectedIndex += direction;
              if(this.selectedIndex < 0) this.selectedIndex = this.suggestions.length - 1;
              if(this.selectedIndex >= this.suggestions.length) this.selectedIndex = 0;
            },
            
            selectSuggestion(item){
              if(!item) return;
              this.query = item.name;
              this.showSuggestions = false;
              this.performSearch();
            },
            
            performSearch(){
              if(!this.query.trim()) return;
              
              // Save to popular searches
              try{
                const stored = JSON.parse(localStorage.getItem('popular_searches') || '[]');
                if(!stored.includes(this.query.trim())){
                  stored.unshift(this.query.trim());
                  if(stored.length > 10) stored.pop();
                  localStorage.setItem('popular_searches', JSON.stringify(stored));
                }
              }catch{}
              
              // Redirect to search results
              const searchUrl = `/shop?q=${encodeURIComponent(this.query.trim())}`;
              window.location.href = searchUrl;
            }
          }
        }
        
        function chatWidget(){
          return { open:false, input:'', msgs:[], welcome:'@Html.Raw((string.Equals(ViewBag.ChatWelcome as string, "chat_welcome") || string.IsNullOrWhiteSpace(ViewBag.ChatWelcome as string)) ? "<span class=\"text-muted\">Hỏi: tên sản phẩm, mã giảm, khoảng giá...</span>" : ViewBag.ChatWelcome)', isHubReady:false, connection:null, formatPrice(v){ try{ return new Intl.NumberFormat('vi-VN').format(v); }catch{ return v; } }, async init(){ try{ if(window.signalR){ this.connection = new signalR.HubConnectionBuilder().withUrl('/chatHub').withAutomaticReconnect().build(); this.connection.on('ReceiveMessage', (reply, items, coupons) => { this.msgs.push({ role:'bot', text: reply, items: items||[], coupons: coupons||[] }); }); await this.connection.start(); this.isHubReady = true; } }catch(e){ this.isHubReady=false; } }, async send(){ const t=this.input.trim(); if(!t) return; this.msgs.push({role:'user', text:t}); this.input=''; if(this.isHubReady && this.connection){ try{ await this.connection.invoke('SendQuestion', t); return; }catch(e){ } } try{ const r=await fetch('/api/chat',{ method:'POST', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify({ text:t }) }); const j=await r.json(); this.msgs.push({ role:'bot', text:j.reply, items:j.items||[], coupons:j.coupons||[] }); } catch(_){ this.msgs.push({ role:'bot', text:'@((string.Equals(ViewBag.ChatConnectionError as string, "chat_connection_error") || string.IsNullOrWhiteSpace(ViewBag.ChatConnectionError as string)) ? "Lỗi kết nối máy chủ, vui lòng thử lại." : ViewBag.ChatConnectionError)' }); } } }
        }
      </script>
