@{
    ViewData["Title"] = ViewBag.AuthForgotPasswordTitle;
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
<!-- section -->
<section class="my-lg-14 my-8">
    <!-- container -->
    <div class="container">
        <!-- row -->
        <div class="row justify-content-center align-items-center">
            <div class="col-12 col-md-6 col-lg-4 order-lg-1 order-2">
                <!-- img -->
                <img src="~/assets/images/svg-graphics/fp-g.svg" alt="" class="img-fluid" />
            </div>
            <div class="col-12 col-md-6 offset-lg-1 col-lg-4 order-lg-2 order-1 d-flex align-items-center">
                <div>
                    <div class="mb-lg-9 mb-5">
                        <!-- heading -->
                        <h1 class="mb-2 h2 fw-bold">@ViewBag.AuthForgotPasswordTitle</h1>
                        <p>@ViewBag.AuthForgotPasswordSubtitle</p>
                    </div>
                    <!-- form -->
                    <form class="needs-validation" id="forgotForm" novalidate>
                        <!-- row -->
                        <div class="row g-3">
                            <!-- col -->
                            <div class="col-12">
                                <!-- input -->
                                <label for="formForgetEmail" class="form-label visually-hidden">@ViewBag.AuthEmail</label>
                                <input type="email" class="form-control" id="formForgetEmail" placeholder="@ViewBag.AuthSignInEmailPlaceholder" required />
                                <div class="invalid-feedback">@ViewBag.ValidationEnterEmail</div>
                            </div>

                            <!-- btn -->
                            <div class="col-12 d-grid gap-2">
                                <button type="submit" class="btn btn-primary">@ViewBag.AuthResetPasswordButton</button>
                                <a href="@Url.Action("SignIn","AuthView")" class="btn btn-light">@ViewBag.AuthBackButton</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
// Map API code -> localized messages
const CODE_MAP = {
    otp_sent: '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)(ViewBag.ForgotOtpSent ?? ""))',
    email_not_found: '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)(ViewBag.ResetEmailNotFound ?? ""))',
    validation_enter_email: '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)(ViewBag.ValidationEnterEmail ?? ""))',
    internal_server_error: '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)(ViewBag.GenericError ?? ""))'
};
function msg(code, fallback) { return CODE_MAP[code] || fallback || ''; }
document.getElementById("forgotForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = document.getElementById("formForgetEmail").value.trim();
    if (!email) {
        alert('@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.ValidationEnterEmail)');
        return;
    }
    try {
        const res = await fetch('@Url.Action("ForgotPassword","Auth")', {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email })
        });
        const json = await res.json();
        if (res.ok) {
            alert(msg(json.code, '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)(ViewBag.ForgotOtpSent ?? ""))'));
            localStorage.setItem("pendingResetEmail", email);
            window.location.href = '@Url.Action("ResetPassword","AuthView")';
        } else {
            alert(msg(json.code, '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)(ViewBag.GenericError ?? ""))'));
        }
    } catch (err) {
        console.error(err);
    alert('@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.GenericError)');
    }
});
</script>
