@{
  ViewData["Title"] = ViewBag.AuthResetPassword;
  Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<section class="my-lg-14 my-8">
  <div class="container">
    <div class="row justify-content-center align-items-center">
      <div class="col-12 col-md-6 col-lg-5">
        <div class="card shadow-lg p-5 rounded-4">
          <h2 class="fw-bold mb-3 text-center">@ViewBag.AuthResetPassword</h2>
          <p class="text-center text-muted mb-4">@ViewBag.ResetSubtitle</p>
          <form id="resetForm">
            <div class="mb-3">
              <label for="email" class="form-label">@ViewBag.AuthEmailAddress</label>
              <input type="email" class="form-control" id="email" readonly />
            </div>
            <div class="mb-3">
              <label for="otp" class="form-label">@ViewBag.OtpLabel</label>
              <input type="text" class="form-control" id="otp" maxlength="6" placeholder="@ViewBag.OtpPlaceholder" required />
            </div>
            <div class="mb-3">
              <label for="newPassword" class="form-label">@ViewBag.AuthSignInPasswordLabel</label>
              <input type="password" class="form-control" id="newPassword" placeholder="@ViewBag.ResetPasswordPlaceholder" required />
            </div>
            <div class="d-grid">
              <button type="submit" class="btn btn-primary">@ViewBag.AuthResetPasswordButton</button>
            </div>
          </form>
          <p class="text-center mt-3">
            <a href="/auth/signin">@ViewBag.AuthBackButton</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const emailInput = document.getElementById("email");
    const pendingEmail = localStorage.getItem("pendingResetEmail");
    if (pendingEmail) {
      emailInput.value = pendingEmail;
      emailInput.readOnly = true;
    } else {
  alert('@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.ResetEmailNotFound)');
      window.location.href = "/auth/forgot-password";
    }
  });

  document.getElementById("resetForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = document.getElementById("email").value.trim();
    const otp = document.getElementById("otp").value.trim();
    const newPassword = document.getElementById("newPassword").value.trim();
    if (!otp || !newPassword) {
  alert('@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.ValidationFillAll)');
      return;
    }
    try {
      const res = await fetch("/api/auth/reset-password", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, otp, newPassword })
      });
      const json = await res.json();
      if (res.ok) {
  alert(json.message || '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.ResetSuccess)');
        localStorage.removeItem("pendingResetEmail");
        window.location.href = "/auth/signin";
      } else {
  alert("" + (json.message || '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.ResetFailed)'));
      }
    } catch (err) {
      console.error(err);
  alert('@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.ServerConnectionError)');
    }
  });
</script>
