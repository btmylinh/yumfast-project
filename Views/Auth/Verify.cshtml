@{
    ViewData["Title"] = ViewBag.VerifyTitle;
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<section class="my-lg-14 my-8">
    <div class="container">
        <div class="row justify-content-center align-items-center">
            <div class="col-12 col-md-6 col-lg-5">
                <div class="card shadow-lg p-5 rounded-4">
                    <h2 class="fw-bold mb-3 text-center">@ViewBag.VerifyTitle</h2>
                    <p class="text-center text-muted mb-4">
                        @ViewBag.VerifySubtitle
                    </p>

                    <form id="verifyForm">
                        <div class="mb-3">
                            <label for="email" class="form-label">@ViewBag.AuthEmailAddress</label>
                            <input type="email" class="form-control" id="email" placeholder="@ViewBag.AuthEmailPlaceholder" autocomplete="email" required>
                        </div>

                        <div class="mb-3">
                            <label for="otp" class="form-label">@ViewBag.OtpLabel</label>
                            <input type="text" class="form-control" id="otp" maxlength="6" placeholder="@ViewBag.OtpPlaceholder" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" required>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">@ViewBag.VerifyButton</button>
                            <button type="button" id="resendBtn" class="btn btn-outline-secondary">@ViewBag.ResendOtpButton</button>
                        </div>
                    </form>

                    <p class="text-center mt-3">
                        <a href="@Url.Action("SignIn", "Auth")">@ViewBag.AuthBackButton</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
// Localized code-to-message map (shared by both handlers)
const CODE_MAP = {
    verify_success: '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)(ViewBag.VerifySuccess ?? ""))',
    otp_invalid_or_expired: '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)(ViewBag.OtpInvalidOrExpired ?? ""))',
    internal_server_error: '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)(ViewBag.GenericError ?? ""))',
    // Resend OTP specific
    resend_success: '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)(ViewBag.ResendOtpSuccess ?? ViewBag.VerifySuccess ?? ""))',
    too_many_requests: '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)(ViewBag.TooManyRequests ?? ViewBag.GenericError ?? ""))',
    user_not_found: '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)(ViewBag.UserNotFound ?? ViewBag.GenericError ?? ""))',
    email_not_found: '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)(ViewBag.VerifyEmailNotFound ?? ViewBag.GenericError ?? ""))'
};

function messageFromCode(code, fallback) {
    return CODE_MAP[code] || fallback || '';
}
// Auto-fill email from localStorage, redirect if missing
document.addEventListener("DOMContentLoaded", function() {
    const emailInput = document.getElementById("email");
    const pendingEmail = localStorage.getItem("pendingEmail");
    if (pendingEmail) {
        emailInput.value = pendingEmail;
        emailInput.readOnly = true;
    } else {
        alert('@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.VerifyEmailNotFound)');
        window.location.href = '@Url.Action("SignUp","AuthView")';
    }
});
document.getElementById("verifyForm").addEventListener("submit", async (e) => {
    e.preventDefault();

    const email = document.getElementById("email").value.trim();
    const code = document.getElementById("otp").value.trim();

    const res = await fetch('@Url.Action("VerifyOtp","Auth")', {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, code })
    });

    const json = await res.json();

    if (res.ok) {
        alert(messageFromCode(json.code, '@ViewBag.VerifySuccess'));
        // Clear the pending email on successful verification
        localStorage.removeItem('pendingEmail');
    window.location.href = '@Url.Action("SignIn","AuthView")';
    } else {
        alert(messageFromCode(json.code, '@ViewBag.GenericError'));
    }
});

// Gửi lại OTP
document.getElementById("resendBtn").addEventListener("click", async () => {
    const email = document.getElementById("email").value.trim();
    if (!email) {
    alert('@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.ResendEnterEmailFirst)');
        return;
    }

    const res = await fetch('@Url.Action("ResendOtp","Auth")', {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email })
    });

    const json = await res.json();
    if (res.ok) {
        alert(messageFromCode(json.code, json.code || ''));
    } else {
        alert(messageFromCode(json.code, json.code || ''));
    }
});
</script>
