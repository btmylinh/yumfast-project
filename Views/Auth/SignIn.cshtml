@{
   ViewData["Title"] = ViewBag.AuthSignInTitle;
   Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
<section class="my-lg-14 my-8" x-data="{ errorEmail:'', errorPassword:'' }">
   <div class="container">
      <div class="row justify-content-center align-items-center">
         <div class="col-12 col-md-6 col-lg-4 order-lg-1 order-2">
            <img src="~/assets/images/svg-graphics/signin-g.svg" alt="" class="img-fluid" />
         </div>
         <div class="col-12 col-md-6 offset-lg-1 col-lg-4 order-lg-2 order-1">
            <div class="mb-lg-9 mb-5">
               <h1 class="mb-1 h2 fw-bold">@ViewBag.AuthSignInTitle</h1>
               <p>@ViewBag.AuthSignInSubtitle</p>
            </div>

            <form id="loginForm" class="needs-validation" novalidate>
               <div class="row g-3">
                  <div class="col-12">
                     <label for="formSigninEmail" class="form-label visually-hidden">@ViewBag.AuthEmail</label>
                     <input type="email" class="form-control" name="email" id="formSigninEmail" placeholder="@ViewBag.AuthSignInEmailPlaceholder" required :class="{'is-invalid': errorEmail}" />
                     <div class="invalid-feedback" x-text="errorEmail || '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.ValidationEnterEmail)' "></div>
                  </div>
                  <div class="col-12">
                     <div class="password-field position-relative">
                        <label for="formSigninPassword" class="form-label visually-hidden">@ViewBag.AuthSignInPasswordLabel</label>
                        <input type="password" class="form-control" name="password" id="formSigninPassword" placeholder="*****" required :class="{'is-invalid': errorPassword}" />
                        <span><i class="bi bi-eye-slash passwordToggler"></i></span>
                        <div class="invalid-feedback" x-text="errorPassword || '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.ValidationEnterPassword)' "></div>
                     </div>
                  </div>
                  <div class="d-flex justify-content-between">
                     <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault" />
                        <label class="form-check-label" for="flexCheckDefault">@ViewBag.AuthRememberMe</label>
                     </div>
                     <div>
                        <a href="@Url.Action("ForgotPassword","AuthView")">@ViewBag.AuthForgotPassword</a>
                     </div>
                  </div>
                  <div class="col-12 d-grid">
                     <button type="submit" class="btn btn-primary">@ViewBag.AuthSignInButton</button>
                  </div>
                  <div>
                     @ViewBag.AuthNoAccount
                     <a href="@Url.Action("SignUp", "AuthView")">@ViewBag.AuthSignUpLink</a>
                  </div>
               </div>
            </form>
         </div>
      </div>
   </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
<script>
var pIcon = document.querySelector('.passwordToggler');
var pInput = document.getElementById('formSigninPassword');
if(pIcon && pInput){
  pIcon.addEventListener('click', function(){
    var show = pInput.type === 'password';
    pInput.type = show ? 'text' : 'password';
    pIcon.classList.toggle('bi-eye-slash', !show);
    pIcon.classList.toggle('bi-eye', show);
  });
}
document.querySelector("#loginForm").addEventListener("submit", async (e) => {
  e.preventDefault();
  const data = {
    email: document.querySelector("[name='email']").value,
    password: document.querySelector("[name='password']").value
  };

  const res = await fetch('@Url.Action("Login","Auth")', {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(data)
  });

  const json = await res.json();
  const root = document.querySelector('section[x-data]');
  const alpine = root && root.__x && root.__x.$data ? root.__x.$data : null;
  var emailInput = document.getElementById('formSigninEmail');
  var emailFeedback = document.querySelector('#formSigninEmail + .invalid-feedback');
  var passInput = document.getElementById('formSigninPassword');
  var passFeedback = document.querySelector('#formSigninPassword + span + .invalid-feedback');
  if (alpine) { alpine.errorEmail = ''; alpine.errorPassword = ''; }
  emailInput.classList.remove('is-invalid');
  passInput.classList.remove('is-invalid');
  if (emailFeedback) emailFeedback.textContent = '';
  if (passFeedback) passFeedback.textContent = '';

  if (res.ok && json && json.code === 'signin_success') {
    localStorage.setItem("token", json.token);
    window.location.href = "/";
    return;
  }

  const msgInvalid = '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.InvalidPassword)';
  const msgFailed = '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.SignInFailed)';
  const code = json && json.code;
  if (alpine) {
    if (code === 'invalid_password') {
      alpine.errorPassword = msgInvalid || msgFailed;
      document.getElementById('formSigninPassword').focus();
    } else if (code === 'email_not_found' || code === 'account_unverified') {
      alpine.errorEmail = msgFailed;
      document.getElementById('formSigninEmail').focus();
    } else {
      alpine.errorEmail = msgFailed;
    }
  } else {
    if (code === 'invalid_password'){
      passInput.classList.add('is-invalid');
      if (passFeedback) passFeedback.textContent = msgInvalid || msgFailed;
      passInput.focus();
    } else if (code === 'email_not_found' || code === 'account_unverified'){
      emailInput.classList.add('is-invalid');
      if (emailFeedback) emailFeedback.textContent = msgFailed;
      emailInput.focus();
    } else {
      emailInput.classList.add('is-invalid');
      if (emailFeedback) emailFeedback.textContent = msgFailed;
    }
  }
});
</script>
