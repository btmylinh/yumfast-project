<script>
document.addEventListener('DOMContentLoaded', () => {
  const btn = document.getElementById('btnAddToCart');
  if (!btn) return;
  btn.addEventListener('click', async () => {
    // Kiểm tra đăng nhập trước khi thêm vào giỏ hàng
    if (typeof authHelper !== 'undefined' && !authHelper.isLoggedIn()) {
      await authHelper.showLoginModal('Vui lòng đăng nhập để thêm sản phẩm vào giỏ hàng');
      return;
    }

    const m = location.pathname.match(/product\/(?:detail\/)?(\d+)/i);
    const id = m ? parseInt(m[1]) : null;
    if (!id) return;
    const qtyInput = document.querySelector('input[name="quantity"]');
    const qty = Math.max(1, parseInt((qtyInput && qtyInput.value) || '1'));
    const opt = document.getElementById('productOptions');
    const options = {};
    if (opt) {
      Array.from(opt.querySelectorAll('button.active')).forEach(b => {
        const t = b.dataset.type || 'Options';
        const n = b.dataset.name || (b.textContent || '').trim();
        options[t] = n;
      });
    }

    try {
    const res = await fetch('/api/cart/add', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ productId: id, quantity: qty, options }) });
      if (res.ok) {
        alert('@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.AddedToCartSuccess)');
        window.dispatchEvent(new Event('cart:changed'));
      } else if (res.status === 401) {
        await authHelper.showLoginModal('Phiên đăng nhập hết hạn. Vui lòng đăng nhập lại.');
      } else {
        alert('@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.GenericError)');
      }
    } catch(err) {
      alert('@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.ServerConnectionError)');
    }
  });
  const viewBtn = document.getElementById('btnViewReviews');
  if (viewBtn) {
    viewBtn.addEventListener('click', () => {
      const tabBtn = document.getElementById('reviews-tab');
      if (tabBtn) tabBtn.click();
      const target = document.getElementById('reviews-tab-pane');
      if (target) target.scrollIntoView({ behavior: 'smooth' });
    });
  }
});
</script>
