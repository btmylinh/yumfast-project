</div>

<script>
// JavaScript để xử lý modal chi tiết đơn hàng
document.addEventListener('DOMContentLoaded', function() {
    const viewOrderBtns = document.querySelectorAll('.view-order-btn');
    
    viewOrderBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            const orderId = this.dataset.orderId;
            const orderDate = this.dataset.orderDate;
            const orderStatus = this.dataset.orderStatus;
            const orderTotal = this.dataset.orderTotal;
            
            // Cập nhật thông tin trong modal
            document.getElementById('orderNumber').textContent = orderId;
            document.getElementById('modalOrderId').textContent = orderId;
            document.getElementById('modalOrderDate').textContent = orderDate;
            document.getElementById('modalTotal').textContent = orderTotal;
            
            // Cập nhật status badge
            const statusBadge = document.getElementById('modalOrderStatus');
            statusBadge.textContent = orderStatus;
            statusBadge.className = 'badge ' + getStatusClass(orderStatus);
        });
    });
    
    function getStatusClass(status) {
        switch(status.toLowerCase()) {
            case 'completed': return 'bg-success';
            case 'processing': return 'bg-warning';
            case 'cancel': return 'bg-danger';
            default: return 'bg-secondary';
        }
    }
});
</script>
