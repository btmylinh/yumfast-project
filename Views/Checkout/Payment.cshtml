@{
    ViewData["Title"] = "Thanh toán đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
<style>
    [x-cloak] { display: none !important; }
    
    .payment-method {
        cursor: pointer;
        transition: all 0.2s;
        border: 2px solid #e5e7eb;
    }
    
    .payment-method.selected {
        border-color: #0aad0a !important;
        background-color: #f0fdf4;
    }
    
    .payment-method:hover {
        border-color: #34d399;
    }
    
    .payment-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }
</style>

<main>
    <div class="container my-5" x-data="checkoutApp()" x-init="init()" x-cloak>
        
        <!-- Page Header -->
        <div class="row mb-4">
            <div class="col-12">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a href="/Shop">Sản phẩm</a></li>
                        <li class="breadcrumb-item active">Thanh toán</li>
                    </ol>
                </nav>
                <h2 class="mt-3 mb-0"><i class="bi bi-credit-card me-2"></i>Thanh toán đơn hàng</h2>
            </div>
        </div>

        <!-- Loading State -->
        <div x-show="loading" class="text-center py-5">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Đang tải...</span>
            </div>
            <p class="mt-3 text-muted">Đang tải giỏ hàng...</p>
        </div>

        <!-- Main Content -->
        <div x-show="!loading" class="row g-4">
            <div class="col-lg-8">
                
                <!-- Shipping Address Card -->
                <div class="card mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">
                            <i class="bi bi-geo-alt text-success me-2"></i>Địa chỉ giao hàng
                        </h5>
                    </div>
                    <div class="card-body">
                        
                        <!-- Has Address -->
                        <div x-show="shippingAddress">
                            <div class="d-flex align-items-start justify-content-between">
                                <div class="flex-grow-1">
                                    <div class="fw-semibold mb-1" x-text="shippingAddress?.name"></div>
                                    <div class="text-muted small mb-1">
                                        <i class="bi bi-telephone me-1"></i>
                                        <span x-text="shippingAddress?.phone"></span>
                                    </div>
                                    <div class="text-muted small" x-text="shippingAddress?.address"></div>
                                </div>
                                <button data-bs-toggle="modal" data-bs-target="#addressModal" class="btn btn-sm btn-outline-success">
                                    Thay đổi
                                </button>
                            </div>
                        </div>

                        <!-- No Address -->
                        <div x-show="!shippingAddress" class="text-center py-4">
                            <i class="bi bi-geo-alt text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mb-3 mt-2">Chưa có địa chỉ giao hàng</p>
                            <button data-bs-toggle="modal" data-bs-target="#addressModal" class="btn btn-success">
                                <i class="bi bi-plus-circle me-2"></i>Thêm địa chỉ
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Payment Methods Card -->
                <div class="card mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">
                            <i class="bi bi-wallet2 text-primary me-2"></i>Phương thức thanh toán
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            
                            <!-- COD -->
                            <div class="col-md-4">
                                <div class="payment-method p-3 rounded h-100"
                                     :class="{'selected': paymentMethod === 'COD'}"
                                     @@click="selectPaymentMethod('COD')">
                                    <div class="text-center">
                                        <div class="payment-icon bg-success bg-opacity-10 text-success mx-auto mb-2">
                                            <i class="bi bi-cash-coin"></i>
                                        </div>
                                        <div class="fw-semibold">Thanh toán khi nhận hàng</div>
                                        <div class="text-muted small mt-1">Tiền mặt / COD</div>
                                    </div>
                                </div>
                            </div>

                            <!-- VNPay -->
                            <div class="col-md-4">
                                <div class="payment-method p-3 rounded h-100"
                                     :class="{'selected': paymentMethod === 'VNPAY'}"
                                     @@click="selectPaymentMethod('VNPAY')">
                                    <div class="text-center">
                                        <div class="payment-icon bg-primary bg-opacity-10 text-primary mx-auto mb-2">
                                            <i class="bi bi-credit-card"></i>
                                        </div>
                                        <div class="fw-semibold">VNPay</div>
                                        <div class="text-muted small mt-1">ATM / Visa / QR</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Momo -->
                            <div class="col-md-4">
                                <div class="payment-method p-3 rounded h-100"
                                     :class="{'selected': paymentMethod === 'MOMO'}"
                                     @@click="selectPaymentMethod('MOMO')">
                                    <div class="text-center">
                                        <div class="payment-icon bg-danger bg-opacity-10 text-danger mx-auto mb-2">
                                            <i class="bi bi-phone"></i>
                                        </div>
                                        <div class="fw-semibold">Momo</div>
                                        <div class="text-muted small mt-1">Ví điện tử</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Coupon Card -->
                <div class="card mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">
                            <i class="bi bi-tag text-danger me-2"></i>Mã giảm giá
                        </h5>
                    </div>
                    <div class="card-body">
                        
                        <!-- Manual Voucher Input -->
                        <div class="mb-3">
                            <label class="form-label small text-muted">Nhập mã voucher</label>
                            <div class="input-group">
                                <input type="text" 
                                       x-model="voucherCode" 
                                       class="form-control" 
                                       placeholder="Nhập mã giảm giá..."
                                       @@keyup.enter="applyVoucherCode">
                                <button type="button" 
                                        class="btn btn-primary" 
                                        @@click="applyVoucherCode"
                                        :disabled="!voucherCode || applyingVoucher">
                                    <span x-show="!applyingVoucher">Áp dụng</span>
                                    <span x-show="applyingVoucher">
                                        <span class="spinner-border spinner-border-sm"></span>
                                    </span>
                                </button>
                            </div>
                        </div>

                        <div class="text-center text-muted mb-3">
                            <small>— hoặc chọn mã có sẵn —</small>
                        </div>
                        
                        <div x-show="availableCoupons.length === 0" class="text-center text-muted py-3">
                            <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                            <p class="mb-0 mt-2">Không có mã giảm giá khả dụng</p>
                        </div>
                        
                        <div x-show="availableCoupons.length > 0">
                            <!-- Coupon List with Max Height and Scroll -->
                            <div :style="showAllCoupons ? 'max-height: 400px; overflow-y: auto;' : ''">
                                <template x-for="(coupon, index) in availableCoupons" :key="coupon.id">
                                    <div x-show="showAllCoupons || index < 3"
                                         class="form-check border rounded p-3 mb-2" 
                                         :class="{'border-success': selectedCoupon?.id === coupon.id, 'bg-success bg-opacity-10': selectedCoupon?.id === coupon.id}"
                                         style="cursor: pointer;"
                                         @@click="selectCoupon(coupon)">
                                        <input class="form-check-input" 
                                               type="radio" 
                                               name="coupon" 
                                               :id="'coupon-' + coupon.id"
                                               :checked="selectedCoupon?.id === coupon.id">
                                        <label class="form-check-label w-100" :for="'coupon-' + coupon.id" style="cursor: pointer;">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="text-dark">
                                                    <div class="fw-bold" 
                                                         :class="selectedCoupon?.id === coupon.id ? 'text-dark' : 'text-success'"
                                                         x-text="coupon.code"></div>
                                                    <div class="small" 
                                                         :class="selectedCoupon?.id === coupon.id ? 'text-dark' : 'text-muted'"
                                                         x-text="coupon.description"></div>
                                                    <div class="small mt-1" 
                                                         :class="selectedCoupon?.id === coupon.id ? 'text-dark' : 'text-muted'">
                                                        <span x-show="coupon.discountType === 'percentage'">
                                                            Giảm <span x-text="coupon.discountValue"></span>%
                                                        </span>
                                                        <span x-show="coupon.discountType === 'fixed'">
                                                            Giảm <span x-text="formatMoney(coupon.discountValue)"></span>
                                                        </span>
                                                        <span x-show="coupon.minOrderValue > 0">
                                                            - Đơn tối thiểu <span x-text="formatMoney(coupon.minOrderValue)"></span>
                                                        </span>
                                                    </div>
                                                </div>
                                                <i class="bi bi-check-circle-fill text-success" 
                                                   x-show="selectedCoupon?.id === coupon.id"></i>
                                            </div>
                                        </label>
                                    </div>
                                </template>
                            </div>
                            
                            <!-- Show More / Show Less Button -->
                            <button x-show="availableCoupons.length > 3" 
                                    @@click="showAllCoupons = !showAllCoupons"
                                    class="btn btn-sm btn-outline-primary w-100 mt-2">
                                <template x-if="!showAllCoupons">
                                    <span><i class="bi bi-chevron-down me-1"></i>Xem thêm (<span x-text="availableCoupons.length - 3"></span> mã)</span>
                                </template>
                                <template x-if="showAllCoupons">
                                    <span><i class="bi bi-chevron-up me-1"></i>Thu gọn</span>
                                </template>
                            </button>
                            
                            <button x-show="selectedCoupon" 
                                    @@click="clearCoupon" 
                                    class="btn btn-sm btn-outline-secondary w-100 mt-2">
                                <i class="bi bi-x-circle me-1"></i>Bỏ chọn mã giảm giá
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Order Notes Card -->
                <div class="card">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">
                            <i class="bi bi-pencil text-warning me-2"></i>Ghi chú đơn hàng
                        </h5>
                    </div>
                    <div class="card-body">
                        <textarea x-model="notes" 
                                  class="form-control" 
                                  rows="3" 
                                  placeholder="Ví dụ: Giao hàng giờ hành chính, gọi trước 15 phút..."></textarea>
                    </div>
                </div>

            </div>

            <!-- Order Summary Sidebar -->
            <div class="col-lg-4">
                <div class="card sticky-top" style="top: 100px;">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">
                            <i class="bi bi-cart3 text-success me-2"></i>Đơn hàng của bạn
                        </h5>
                    </div>
                    <div class="card-body">
                        
                        <!-- Cart Items -->
                        <div class="mb-3">
                            <template x-for="item in cartItems" :key="item.productId">
                                <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                                    <img :src="item.imageUrl || '/assets/images/products/product-img-1.jpg'" 
                                         :alt="item.productName"
                                         class="rounded me-3"
                                         style="width: 60px; height: 60px; object-fit: cover;">
                                    <div class="flex-grow-1">
                                        <div class="fw-medium mb-1" x-text="item.productName"></div>
                                        <div class="text-muted small">
                                            <span x-text="formatMoney(item.price)"></span> × <span x-text="item.quantity"></span>
                                        </div>
                                    </div>
                                    <div class="fw-semibold" x-text="formatMoney(item.price * item.quantity)"></div>
                                </div>
                            </template>
                        </div>

                        <!-- Pricing -->
                        <div class="border-top pt-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Tạm tính</span>
                                <span x-text="formatMoney(subtotal)"></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Phí vận chuyển</span>
                                <span x-text="formatMoney(shippingFee)"></span>
                            </div>
                            <div x-show="discount > 0" class="d-flex justify-content-between mb-2 text-success">
                                <span>Giảm giá</span>
                                <span>-<span x-text="formatMoney(discount)"></span></span>
                            </div>
                            <div class="d-flex justify-content-between mt-3 pt-3 border-top">
                                <span class="fw-bold fs-5">Tổng cộng</span>
                                <span class="fw-bold fs-5 text-success" x-text="formatMoney(total)"></span>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <button @@click="submitOrder" 
                                :disabled="submitting || !shippingAddress || cartItems.length === 0"
                                class="btn btn-success btn-lg w-100 mt-4">
                            <span x-show="!submitting">
                                <i class="bi bi-check-circle me-2"></i>Đặt hàng ngay
                            </span>
                            <span x-show="submitting">
                                <span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...
                            </span>
                        </button>

                        <div x-show="!shippingAddress" class="alert alert-warning mt-3 mb-0 small">
                            <i class="bi bi-exclamation-triangle me-2"></i>Vui lòng thêm địa chỉ giao hàng
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Address Modal (Bootstrap Modal) -->
        <div class="modal fade" id="addressModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="bi bi-geo-alt me-2"></i>
                            <span x-text="shippingAddress ? 'Sửa địa chỉ' : 'Thêm địa chỉ mới'"></span>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Họ tên người nhận <span class="text-danger">*</span></label>
                            <input type="text" x-model="addressForm.name" class="form-control" placeholder="Nguyễn Văn A">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" x-model="addressForm.phone" class="form-control" placeholder="0901234567">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Địa chỉ chi tiết <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <textarea x-model="addressForm.address" class="form-control" rows="3" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố"></textarea>
                                <button type="button" class="btn btn-outline-primary" @@click="getLocationFromGPS" title="Lấy vị trí hiện tại">
                                    <i class="bi bi-geo-alt-fill"></i>
                                </button>
                            </div>
                            <small class="text-muted">Nhấn nút <i class="bi bi-geo-alt-fill"></i> để lấy địa chỉ từ vị trí hiện tại</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" class="btn btn-success" @@click="saveAddress">
                            <i class="bi bi-check-circle me-2"></i>Lưu địa chỉ
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Toast Notification -->
        <div x-show="toast.show" 
             class="position-fixed bottom-0 end-0 p-3" 
             style="z-index: 11;">
            <div class="toast show" role="alert">
                <div class="toast-header" :class="{'bg-success text-white': toast.type === 'success', 'bg-danger text-white': toast.type === 'error'}">
                    <i class="bi me-2" :class="toast.type === 'success' ? 'bi-check-circle' : 'bi-exclamation-triangle'"></i>
                    <strong class="me-auto" x-text="toast.type === 'success' ? 'Thành công' : 'Lỗi'"></strong>
                    <button type="button" class="btn-close btn-close-white" @@click="toast.show = false"></button>
                </div>
                <div class="toast-body" x-text="toast.message"></div>
            </div>
        </div>

    </div>

    <script>
        function checkoutApp() {
            return {
                loading: true,
                cartItems: [],
                shippingAddress: null,
                paymentMethod: 'COD',
                notes: '',
                subtotal: 0,
                shippingFee: 30000,
                discount: 0,
                total: 0,
                submitting: false,
                availableCoupons: [],
                selectedCoupon: null,
                voucherCode: '',
                applyingVoucher: false,
                showAllCoupons: false,
                addressForm: {
                    name: '',
                    phone: '',
                    address: ''
                },
                toast: {
                    show: false,
                    type: 'success',
                    message: ''
                },

                async init() {
                    await this.loadCart();
                    await this.loadShippingAddress();
                    await this.loadAvailableCoupons();
                    await this.calculateShipping();
                    this.loading = false;
                },

                async loadCart() {
                    try {
                        const response = await fetch('/api/cart');
                        if (!response.ok) throw new Error('Failed to load cart');
                        
                        const result = await response.json();
                        // API response: { data: [...], total: ... }
                        this.cartItems = result.data || [];
                        
                        // Map field names: id -> productId, name -> productName, image -> imageUrl
                        this.cartItems = this.cartItems.map(item => ({
                            productId: item.id,
                            productName: item.name,
                            price: item.price,
                            quantity: item.quantity,
                            imageUrl: item.image
                        }));
                        
                        this.subtotal = this.cartItems.reduce((sum, item) => sum + (item.price * item.quantity), 0);
                        this.calculateTotal();
                        
                        // Reload coupons after cart loaded (to filter by min order value)
                        await this.loadAvailableCoupons();
                    } catch (error) {
                        console.error('Load cart error:', error);
                        this.showToast('Không thể tải giỏ hàng', 'error');
                    }
                },

                async loadShippingAddress() {
                    // TODO: Load from API /api/profile/addresses
                    const stored = localStorage.getItem('shippingAddress');
                    if (stored) {
                        this.shippingAddress = JSON.parse(stored);
                        this.addressForm = {...this.shippingAddress};
                    }
                },

                async calculateShipping() {
                    // TODO: Call API /api/checkout/quote-shipping with zoneId
                    this.shippingFee = 30000;
                    this.calculateTotal();
                },

                calculateTotal() {
                    this.total = this.subtotal + this.shippingFee - this.discount;
                },

                async loadAvailableCoupons() {
                    try {
                        const response = await fetch('/api/coupons/available');
                        if (!response.ok) throw new Error('Failed to load coupons');
                        
                        const result = await response.json();
                        if (result.success) {
                            // Filter coupons that meet minimum order value
                            this.availableCoupons = (result.data || []).filter(coupon => 
                                !coupon.minOrderValue || this.subtotal >= coupon.minOrderValue
                            );
                        }
                    } catch (error) {
                        console.error('Load coupons error:', error);
                        // Không hiển thị lỗi để không làm phiền user
                    }
                },

                selectCoupon(coupon) {
                    if (this.selectedCoupon?.id === coupon.id) {
                        // Click lại coupon đang chọn → bỏ chọn
                        this.clearCoupon();
                    } else {
                        this.selectedCoupon = coupon;
                        this.applyCoupon();
                    }
                },

                applyCoupon() {
                    if (!this.selectedCoupon) return;

                    // Check minimum order value
                    if (this.selectedCoupon.minOrderValue && this.subtotal < this.selectedCoupon.minOrderValue) {
                        this.showToast(`Đơn hàng tối thiểu ${this.formatMoney(this.selectedCoupon.minOrderValue)}`, 'error');
                        this.clearCoupon();
                        return;
                    }

                    // Calculate discount
                    if (this.selectedCoupon.discountType === 'percentage') {
                        this.discount = Math.round(this.subtotal * this.selectedCoupon.discountValue / 100);
                        // Max discount if specified
                        if (this.selectedCoupon.maxDiscountValue && this.discount > this.selectedCoupon.maxDiscountValue) {
                            this.discount = this.selectedCoupon.maxDiscountValue;
                        }
                    } else if (this.selectedCoupon.discountType === 'fixed') {
                        this.discount = this.selectedCoupon.discountValue;
                    }

                    this.calculateTotal();
                    this.showToast(`Đã áp dụng mã ${this.selectedCoupon.code}`, 'success');
                },

                clearCoupon() {
                    this.selectedCoupon = null;
                    this.voucherCode = '';
                    this.discount = 0;
                    this.calculateTotal();
                },

                async applyVoucherCode() {
                    if (!this.voucherCode || !this.voucherCode.trim()) {
                        this.showToast('Vui lòng nhập mã voucher', 'error');
                        return;
                    }

                    this.applyingVoucher = true;

                    try {
                        const response = await fetch('/api/coupons/validate', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                code: this.voucherCode.trim(),
                                orderAmount: this.subtotal
                            })
                        });

                        const result = await response.json();

                        if (result.success) {
                            this.selectedCoupon = result.data;
                            this.applyCoupon();
                            this.voucherCode = '';
                        } else {
                            this.showToast(result.message || 'Mã voucher không hợp lệ', 'error');
                        }
                    } catch (error) {
                        console.error('Apply voucher error:', error);
                        this.showToast('Lỗi khi kiểm tra mã voucher', 'error');
                    } finally {
                        this.applyingVoucher = false;
                    }
                },

                async getLocationFromGPS() {
                    if (!navigator.geolocation) {
                        this.showToast('Trình duyệt không hỗ trợ định vị', 'error');
                        return;
                    }

                    this.showToast('Đang lấy vị trí...', 'success');

                    navigator.geolocation.getCurrentPosition(
                        async (position) => {
                            const lat = position.coords.latitude;
                            const lng = position.coords.longitude;

                            try {
                                // Reverse geocoding using Nominatim (OpenStreetMap)
                                const response = await fetch(
                                    `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&addressdetails=1`,
                                    { headers: { 'Accept-Language': 'vi' } }
                                );
                                
                                if (!response.ok) throw new Error('Geocoding failed');
                                
                                const data = await response.json();
                                
                                // Build address string
                                const addr = data.address;
                                let addressParts = [];
                                
                                if (addr.house_number) addressParts.push(addr.house_number);
                                if (addr.road) addressParts.push(addr.road);
                                if (addr.quarter || addr.suburb) addressParts.push(addr.quarter || addr.suburb);
                                if (addr.city_district || addr.county) addressParts.push(addr.city_district || addr.county);
                                if (addr.city || addr.town) addressParts.push(addr.city || addr.town);
                                if (addr.state) addressParts.push(addr.state);
                                
                                this.addressForm.address = addressParts.join(', ');
                                this.showToast('Đã lấy địa chỉ từ vị trí hiện tại', 'success');
                                
                            } catch (error) {
                                console.error('Geocoding error:', error);
                                this.addressForm.address = `Latitude: ${lat}, Longitude: ${lng}`;
                                this.showToast('Lấy tên địa chỉ thất bại, đã điền tọa độ GPS', 'error');
                            }
                        },
                        (error) => {
                            let errorMsg = 'Không thể lấy vị trí';
                            if (error.code === 1) errorMsg = 'Bạn chưa cho phép truy cập vị trí';
                            else if (error.code === 2) errorMsg = 'Không thể xác định vị trí';
                            else if (error.code === 3) errorMsg = 'Hết thời gian chờ';
                            
                            this.showToast(errorMsg, 'error');
                        },
                        { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
                    );
                },

                selectPaymentMethod(method) {
                    this.paymentMethod = method;
                },

                saveAddress() {
                    if (!this.addressForm.name || !this.addressForm.phone || !this.addressForm.address) {
                        this.showToast('Vui lòng điền đầy đủ thông tin', 'error');
                        return;
                    }

                    this.shippingAddress = {...this.addressForm};
                    localStorage.setItem('shippingAddress', JSON.stringify(this.shippingAddress));
                    
                    // Close modal using Bootstrap API
                    const modalEl = document.getElementById('addressModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                    
                    this.showToast('Đã lưu địa chỉ giao hàng', 'success');
                    this.calculateShipping();
                },

                async submitOrder() {
                    if (this.cartItems.length === 0) {
                        this.showToast('Giỏ hàng trống', 'error');
                        return;
                    }

                    if (!this.shippingAddress) {
                        this.showToast('Vui lòng thêm địa chỉ giao hàng', 'error');
                        return;
                    }

                    this.submitting = true;

                    try {
                        // Step 1: Create order first
                        const orderData = {
                            shippingAddress: this.shippingAddress,
                            paymentMethod: this.paymentMethod,
                            notes: this.notes,
                            couponCode: this.selectedCoupon?.code || null,
                            items: this.cartItems.map(item => ({
                                productId: item.productId,
                                quantity: item.quantity,
                                price: item.price
                            }))
                        };

                        const orderResponse = await fetch('/api/checkout/create-order', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(orderData)
                        });

                        const orderResult = await orderResponse.json();
                        if (!orderResult.success) {
                            throw new Error(orderResult.message);
                        }

                        const orderId = orderResult.data.orderId;

                        // Step 2: Handle payment based on method
                        if (this.paymentMethod === 'COD') {
                            // COD - Done! Redirect to tracking
                            this.showToast('Đặt hàng thành công!', 'success');
                            setTimeout(() => window.location.href = `/Order/Tracking/${orderId}`, 1500);
                        } else if (this.paymentMethod === 'VNPAY') {
                            // Create VNPay payment
                            const vnpayResponse = await fetch('/api/payment/vnpay/create', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    orderId: orderId,
                                    returnUrl: `${window.location.origin}/api/payment/vnpay/return`
                                })
                            });

                            const vnpayResult = await vnpayResponse.json();
                            if (vnpayResult.success) {
                                // Redirect to VNPay gateway
                                window.location.href = vnpayResult.data.paymentUrl;
                            } else {
                                throw new Error(vnpayResult.message || 'Không thể tạo thanh toán VNPay');
                            }
                        } else if (this.paymentMethod === 'MOMO') {
                            // Create MoMo payment
                            const momoResponse = await fetch('/api/payment/momo/create', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    orderId: orderId,
                                    returnUrl: `${window.location.origin}/api/payment/momo/return`
                                })
                            });

                            const momoResult = await momoResponse.json();
                            if (momoResult.success) {
                                // Redirect to MoMo gateway
                                window.location.href = momoResult.data.paymentUrl;
                            } else {
                                throw new Error(momoResult.message || 'Không thể tạo thanh toán MoMo');
                            }
                        }
                    } catch (error) {
                        console.error('Submit order error:', error);
                        this.showToast(error.message || 'Đặt hàng thất bại', 'error');
                    } finally {
                        this.submitting = false;
                    }
                },

                formatMoney(amount) {
                    return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
                },

                showToast(message, type = 'success') {
                    this.toast = { show: true, type, message };
                    setTimeout(() => {
                        this.toast.show = false;
                    }, 3000);
                }
            };
        }
    </script>
</main>
