@{
    ViewData["Title"] = "Đánh giá đơn hàng";
    var orderId = ViewBag.OrderId;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <style>
        [x-cloak] { display: none !important; }
        
        .star-rating {
            cursor: pointer;
            transition: all 0.2s;
            font-size: 2rem;
            color: #dee2e6;
        }
        
        .star-rating:hover {
            transform: scale(1.1);
        }
        
        .star-rating.active {
            color: #ffc107;
        }
        
        .image-preview {
            position: relative;
            display: inline-block;
        }
        
        .image-preview img {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 0.5rem;
        }
        
        .image-preview .btn-remove {
            position: absolute;
            top: -8px;
            right: -8px;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            border: 2px solid white;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            font-size: 0.75rem;
        }
    </style>
}

<div class="container py-4" x-data="reviewApp(@orderId)" x-init="init()" x-cloak>
    <!-- Header -->
    <div class="d-flex align-items-center mb-4">
        <a href="/Order/MyOrders" class="btn btn-link text-decoration-none me-3">
            <i class="bi bi-arrow-left fs-5"></i>
        </a>
        <h1 class="h4 mb-0 flex-grow-1">Đánh giá đơn hàng</h1>
    </div>

    <!-- Loading State -->
    <div x-show="loading" class="text-center py-5">
        <div class="spinner-border text-warning" role="status">
            <span class="visually-hidden">Đang tải...</span>
        </div>
        <p class="mt-3 text-muted">Đang tải thông tin đơn hàng...</p>
    </div>

    <!-- Main Content -->
    <div x-show="!loading" class="row g-4">
        <div class="col-12">
            <!-- Order Summary -->
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Thông tin đơn hàng</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Mã đơn hàng:</span>
                        <span class="fw-medium" x-text="order.orderCode"></span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Ngày đặt:</span>
                        <span x-text="order.createdAt ? new Date(order.createdAt).toLocaleString('vi-VN') : ''"></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Tổng tiền:</span>
                        <span class="fw-semibold text-warning" x-text="formatMoney(order.totalPrice)"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Rating -->
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Đánh giá đơn hàng</h5>
                    <p class="text-muted small mb-3">Bạn hài lòng với chất lượng sản phẩm và dịch vụ?</p>
                    <div class="d-flex justify-content-center gap-2 mb-2">
                        <template x-for="star in 5" :key="star">
                            <i class="bi bi-star-fill star-rating"
                               :class="star <= orderRating ? 'active' : ''"
                               @@click="selectRating('order', star)"></i>
                        </template>
                    </div>
                    <div class="text-center text-muted small">
                        <span x-show="orderRating === 0">Chưa đánh giá</span>
                        <span x-show="orderRating === 1">Rất tệ</span>
                        <span x-show="orderRating === 2">Tệ</span>
                        <span x-show="orderRating === 3">Trung bình</span>
                        <span x-show="orderRating === 4">Tốt</span>
                        <span x-show="orderRating === 5">Rất tốt</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Driver Rating -->
        <div x-show="order.driverId" class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Đánh giá tài xế</h5>
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-warning bg-gradient rounded-circle d-flex align-items-center justify-content-center text-white fw-bold me-3" 
                             style="width: 48px; height: 48px;">
                            <span x-text="order.driverName ? order.driverName.charAt(0).toUpperCase() : 'D'"></span>
                        </div>
                        <div>
                            <div class="fw-medium" x-text="order.driverName"></div>
                            <div class="text-muted small">Tài xế giao hàng</div>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">Tài xế giao hàng có chuyên nghiệp và thân thiện?</p>
                    <div class="d-flex justify-content-center gap-2 mb-2">
                        <template x-for="star in 5" :key="star">
                            <i class="bi bi-star-fill star-rating"
                               :class="star <= driverRating ? 'active' : ''"
                               @@click="selectRating('driver', star)"></i>
                        </template>
                    </div>
                    <div class="text-center text-muted small">
                        <span x-show="driverRating === 0">Chưa đánh giá</span>
                        <span x-show="driverRating === 1">Rất tệ</span>
                        <span x-show="driverRating === 2">Tệ</span>
                        <span x-show="driverRating === 3">Trung bình</span>
                        <span x-show="driverRating === 4">Tốt</span>
                        <span x-show="driverRating === 5">Rất tốt</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Comment -->
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Nhận xét của bạn</h5>
                    <textarea x-model="comment"
                              class="form-control"
                              rows="5"
                              placeholder="Chia sẻ trải nghiệm của bạn về đơn hàng này..."></textarea>
                    <div class="text-muted small mt-1" x-text="`${comment.length}/500 ký tự`"></div>
                </div>
            </div>
        </div>

        <!-- Image Upload -->
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Hình ảnh (Tối đa 5 ảnh)</h5>
                    
                    <!-- Upload Button -->
                    <label x-show="images.length < 5" 
                           class="btn btn-outline-secondary">
                        <i class="bi bi-camera me-2"></i>Thêm ảnh
                        <input type="file" 
                               class="d-none" 
                               accept="image/*" 
                               multiple
                               @@change="handleImageUpload($event)">
                    </label>

                    <!-- Image Previews -->
                    <div class="d-flex flex-wrap gap-3 mt-3">
                        <template x-for="(image, index) in images" :key="index">
                            <div class="image-preview">
                                <img :src="image" alt="Preview" class="img-thumbnail">
                                <button type="button" 
                                        class="btn btn-danger btn-sm btn-remove" 
                                        @@click="removeImage(index)">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        </template>
                    </div>
                </div>
            </div>
        </div>

        <!-- Submit Button -->
        <div class="col-12">
            <button @@click="submitReview"
                    :disabled="submitting || orderRating === 0"
                    class="btn btn-warning w-100 py-3 fw-semibold"
                    :class="{'opacity-50': submitting || orderRating === 0}">
                <span x-show="!submitting">
                    <i class="bi bi-send me-2"></i>Gửi đánh giá
                </span>
                <span x-show="submitting">
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    Đang gửi...
                </span>
            </button>
            <p x-show="orderRating === 0" class="text-danger small text-center mt-2">
                * Vui lòng đánh giá đơn hàng trước khi gửi
            </p>
        </div>
    </div>

    <!-- Toast Notification -->
    <div x-show="toast.show" 
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 transform translate-x-full"
         x-transition:enter-end="opacity-100 transform translate-x-0"
         x-transition:leave="transition ease-in duration-200"
         x-transition:leave-start="opacity-100 transform translate-x-0"
         x-transition:leave-end="opacity-0 transform translate-x-full"
         class="position-fixed top-0 end-0 p-3"
         style="z-index: 9999;">
        <div class="toast show" 
             :class="toast.type === 'success' ? 'bg-success text-white' : 'bg-danger text-white'"
             role="alert">
            <div class="toast-body d-flex align-items-center">
                <i :class="toast.type === 'success' ? 'bi bi-check-circle-fill me-2' : 'bi bi-exclamation-triangle-fill me-2'"></i>
                <span x-text="toast.message"></span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function reviewApp(orderId) {
            return {
                orderId: orderId,
                order: {},
                loading: true,
                orderRating: 0,
                driverRating: 0,
                comment: '',
                images: [],
                submitting: false,
                toast: { show: false, message: '', type: 'success' },

                async init() {
                    await this.loadOrder();
                    await this.checkExistingReview();
                    this.loading = false;
                },

                async loadOrder() {
                    try {
                        const token = localStorage.getItem('token') || localStorage.getItem('auth_token');
                        const headers = token ? { 'Authorization': 'Bearer ' + token } : { 'credentials': 'include' };
                        
                        const response = await fetch(`/api/orders/${this.orderId}/tracking`, { headers: headers });
                        if (!response.ok) throw new Error('Failed to load order');
                        
                        const result = await response.json();
                        if (result.success) {
                            this.order = result.data;
                            
                            // Kiểm tra xem có thể review không
                            if (!this.order.canReview) {
                                this.showToast('Đơn hàng này không thể đánh giá', 'error');
                                setTimeout(() => window.location.href = '/Order/MyOrders', 2000);
                            }
                        }
                    } catch (error) {
                        console.error('Load order error:', error);
                        this.showToast('Không thể tải thông tin đơn hàng', 'error');
                    }
                },

                async checkExistingReview() {
                    try {
                        const token = localStorage.getItem('token') || localStorage.getItem('auth_token');
                        const headers = token ? { 'Authorization': 'Bearer ' + token } : { 'credentials': 'include' };
                        
                        const response = await fetch(`/api/orderreviews/order/${this.orderId}`, { headers: headers });
                        if (response.ok) {
                            const result = await response.json();
                            if (result.success && result.data) {
                                // Đã có review rồi
                                this.showToast('Đơn hàng này đã được đánh giá', 'error');
                                setTimeout(() => window.location.href = '/Order/MyOrders', 2000);
                            }
                        }
                    } catch (error) {
                        // Chưa có review, OK
                    }
                },

                selectRating(type, value) {
                    if (type === 'order') {
                        this.orderRating = value;
                    } else if (type === 'driver') {
                        this.driverRating = value;
                    }
                },

                handleImageUpload(event) {
                    const files = Array.from(event.target.files);
                    const remaining = 5 - this.images.length;
                    
                    files.slice(0, remaining).forEach(file => {
                        if (file.type.startsWith('image/')) {
                            const reader = new FileReader();
                            reader.onload = (e) => {
                                this.images.push(e.target.result);
                            };
                            reader.readAsDataURL(file);
                        }
                    });

                    event.target.value = ''; // Reset input
                },

                removeImage(index) {
                    this.images.splice(index, 1);
                },

                async submitReview() {
                    if (this.orderRating === 0) {
                        this.showToast('Vui lòng đánh giá đơn hàng', 'error');
                        return;
                    }

                    if (this.comment.length > 500) {
                        this.showToast('Nhận xét không được vượt quá 500 ký tự', 'error');
                        return;
                    }

                    this.submitting = true;

                    try {
                        const token = localStorage.getItem('token') || localStorage.getItem('auth_token');
                        const headers = {
                            'Content-Type': 'application/json',
                            ...(token ? { 'Authorization': 'Bearer ' + token } : {})
                        };
                        
                        const payload = {
                            orderId: this.orderId,
                            orderRating: this.orderRating,
                            driverRating: this.order.driverId ? this.driverRating : null,
                            comment: this.comment,
                            images: this.images
                        };

                        const response = await fetch('/api/orderreviews', {
                            method: 'POST',
                            headers: headers,
                            credentials: 'include',
                            body: JSON.stringify(payload)
                        });

                        const result = await response.json();
                        
                        if (result.success) {
                            this.showToast('Cảm ơn bạn đã đánh giá!', 'success');
                            setTimeout(() => window.location.href = '/Order/MyOrders', 1500);
                        } else {
                            this.showToast(result.message || 'Không thể gửi đánh giá', 'error');
                        }
                    } catch (error) {
                        console.error('Submit review error:', error);
                        this.showToast('Không thể gửi đánh giá', 'error');
                    } finally {
                        this.submitting = false;
                    }
                },

                formatMoney(amount) {
                    return new Intl.NumberFormat('vi-VN', {
                        style: 'currency',
                        currency: 'VND'
                    }).format(amount);
                },

                showToast(message, type = 'success') {
                    this.toast = { show: true, message, type };
                    setTimeout(() => {
                        this.toast.show = false;
                    }, 3000);
                }
            };
        }
    </script>
}
