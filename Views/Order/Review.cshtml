@{
    var orderId = ViewBag.OrderId;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đánh giá đơn hàng #@orderId - YumFast</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        [x-cloak] { display: none !important; }
        
        .star {
            cursor: pointer;
            transition: all 0.2s;
            font-size: 2rem;
        }
        
        .star:hover {
            transform: scale(1.1);
        }
        
        .star.active {
            color: #fbbf24;
        }
        
        .star.inactive {
            color: #d1d5db;
        }
        
        .image-preview {
            position: relative;
            display: inline-block;
        }
        
        .image-preview img {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 0.5rem;
        }
        
        .image-preview button {
            position: absolute;
            top: -8px;
            right: -8px;
            background: #ef4444;
            color: white;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid white;
        }
    </style>
</head>
<body class="bg-gray-50">
    <div x-data="reviewApp(@orderId)" x-init="init()" x-cloak>
        <!-- Header -->
        <div class="bg-white shadow-sm sticky top-0 z-50">
            <div class="max-w-4xl mx-auto px-4 py-3 flex items-center">
                <a href="/Order/MyOrders" class="mr-3">
                    <i class="fas fa-arrow-left text-xl"></i>
                </a>
                <h1 class="text-lg font-semibold flex-1">Đánh giá đơn hàng</h1>
            </div>
        </div>

        <!-- Loading State -->
        <div x-show="loading" class="max-w-4xl mx-auto px-4 py-8 text-center">
            <i class="fas fa-spinner fa-spin text-4xl text-orange-500"></i>
            <p class="mt-4 text-gray-600">Đang tải...</p>
        </div>

        <!-- Main Content -->
        <div x-show="!loading" class="max-w-4xl mx-auto px-4 py-6 space-y-4">
            
            <!-- Order Summary -->
            <div class="bg-white rounded-lg shadow-sm p-4">
                <h2 class="font-semibold text-lg mb-3">Thông tin đơn hàng</h2>
                <div class="flex justify-between text-sm mb-2">
                    <span class="text-gray-600">Mã đơn hàng:</span>
                    <span class="font-medium" x-text="order.orderCode"></span>
                </div>
                <div class="flex justify-between text-sm mb-2">
                    <span class="text-gray-600">Ngày đặt:</span>
                    <span x-text="order.createdAt ? new Date(order.createdAt).toLocaleString('vi-VN') : ''"></span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-gray-600">Tổng tiền:</span>
                    <span class="font-semibold text-orange-500" x-text="formatMoney(order.totalPrice)"></span>
                </div>
            </div>

            <!-- Order Rating -->
            <div class="bg-white rounded-lg shadow-sm p-4">
                <h2 class="font-semibold text-lg mb-3">Đánh giá đơn hàng</h2>
                <p class="text-sm text-gray-600 mb-3">Bạn hài lòng với chất lượng sản phẩm và dịch vụ?</p>
                <div class="flex justify-center gap-2 mb-2">
                    <template x-for="star in 5" :key="star">
                        <i class="fas fa-star star"
                           :class="star <= orderRating ? 'active' : 'inactive'"
                           @@click="selectRating('order', star)"></i>
                    </template>
                </div>
                <div class="text-center text-sm text-gray-600">
                    <span x-show="orderRating === 0">Chưa đánh giá</span>
                    <span x-show="orderRating === 1">Rất tệ</span>
                    <span x-show="orderRating === 2">Tệ</span>
                    <span x-show="orderRating === 3">Trung bình</span>
                    <span x-show="orderRating === 4">Tốt</span>
                    <span x-show="orderRating === 5">Rất tốt</span>
                </div>
            </div>

            <!-- Driver Rating -->
            <div x-show="order.driverId" class="bg-white rounded-lg shadow-sm p-4">
                <h2 class="font-semibold text-lg mb-3">Đánh giá tài xế</h2>
                <div class="flex items-center mb-3">
                    <div class="w-12 h-12 bg-gradient-to-br from-orange-400 to-orange-600 rounded-full flex items-center justify-center text-white font-bold mr-3">
                        <span x-text="order.driverName ? order.driverName.charAt(0).toUpperCase() : 'D'"></span>
                    </div>
                    <div>
                        <div class="font-medium" x-text="order.driverName"></div>
                        <div class="text-sm text-gray-500">Tài xế giao hàng</div>
                    </div>
                </div>
                <p class="text-sm text-gray-600 mb-3">Tài xế giao hàng có chuyên nghiệp và thân thiện?</p>
                <div class="flex justify-center gap-2 mb-2">
                    <template x-for="star in 5" :key="star">
                        <i class="fas fa-star star"
                           :class="star <= driverRating ? 'active' : 'inactive'"
                           @@click="selectRating('driver', star)"></i>
                    </template>
                </div>
                <div class="text-center text-sm text-gray-600">
                    <span x-show="driverRating === 0">Chưa đánh giá</span>
                    <span x-show="driverRating === 1">Rất tệ</span>
                    <span x-show="driverRating === 2">Tệ</span>
                    <span x-show="driverRating === 3">Trung bình</span>
                    <span x-show="driverRating === 4">Tốt</span>
                    <span x-show="driverRating === 5">Rất tốt</span>
                </div>
            </div>

            <!-- Comment -->
            <div class="bg-white rounded-lg shadow-sm p-4">
                <h2 class="font-semibold text-lg mb-3">Nhận xét của bạn</h2>
                <textarea x-model="comment"
                          class="w-full border border-gray-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-orange-500"
                          rows="5"
                          placeholder="Chia sẻ trải nghiệm của bạn về đơn hàng này..."></textarea>
                <div class="text-sm text-gray-500 mt-1" x-text="`${comment.length}/500 ký tự`"></div>
            </div>

            <!-- Image Upload -->
            <div class="bg-white rounded-lg shadow-sm p-4">
                <h2 class="font-semibold text-lg mb-3">Hình ảnh (Tối đa 5 ảnh)</h2>
                
                <!-- Upload Button -->
                <label x-show="images.length < 5" 
                       class="inline-flex items-center px-4 py-2 bg-gray-100 border border-gray-300 rounded-lg cursor-pointer hover:bg-gray-200 transition">
                    <i class="fas fa-camera mr-2"></i>
                    Thêm ảnh
                    <input type="file" 
                           class="hidden" 
                           accept="image/*" 
                           multiple
                           @@change="handleImageUpload($event)">
                </label>

                <!-- Image Previews -->
                <div class="flex flex-wrap gap-3 mt-3">
                    <template x-for="(image, index) in images" :key="index">
                        <div class="image-preview">
                            <img :src="image" alt="Preview">
                            <button type="button" @@click="removeImage(index)">
                                <i class="fas fa-times text-xs"></i>
                            </button>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Submit Button -->
            <button @@click="submitReview"
                    :disabled="submitting || orderRating === 0"
                    class="w-full px-6 py-4 bg-orange-500 text-white rounded-lg hover:bg-orange-600 transition font-semibold text-lg disabled:opacity-50 disabled:cursor-not-allowed">
                <span x-show="!submitting">
                    <i class="fas fa-paper-plane mr-2"></i>Gửi đánh giá
                </span>
                <span x-show="submitting">
                    <i class="fas fa-spinner fa-spin mr-2"></i>Đang gửi...
                </span>
            </button>

            <p x-show="orderRating === 0" class="text-center text-sm text-red-500">
                * Vui lòng đánh giá đơn hàng trước khi gửi
            </p>
        </div>

        <!-- Toast Notification -->
        <div x-show="toast.show" 
             x-transition
             class="fixed top-4 right-4 z-50 max-w-sm w-full bg-white rounded-lg shadow-lg p-4"
             :class="toast.type === 'success' ? 'border-l-4 border-green-500' : 'border-l-4 border-red-500'">
            <div class="flex items-center">
                <i :class="toast.type === 'success' ? 'fas fa-check-circle text-green-500' : 'fas fa-exclamation-circle text-red-500'" 
                   class="text-xl mr-3"></i>
                <p class="flex-1" x-text="toast.message"></p>
            </div>
        </div>
    </div>

    <script>
        function reviewApp(orderId) {
            return {
                orderId: orderId,
                order: {},
                loading: true,
                orderRating: 0,
                driverRating: 0,
                comment: '',
                images: [],
                submitting: false,
                toast: { show: false, message: '', type: 'success' },

                async init() {
                    await this.loadOrder();
                    await this.checkExistingReview();
                    this.loading = false;
                },

                async loadOrder() {
                    try {
                        const response = await fetch(`/api/orders/${this.orderId}/tracking`);
                        if (!response.ok) throw new Error('Failed to load order');
                        
                        const result = await response.json();
                        if (result.success) {
                            this.order = result.data;
                            
                            // Kiểm tra xem có thể review không
                            if (!this.order.canReview) {
                                this.showToast('Đơn hàng này không thể đánh giá', 'error');
                                setTimeout(() => window.location.href = '/Order/MyOrders', 2000);
                            }
                        }
                    } catch (error) {
                        console.error('Load order error:', error);
                        this.showToast('Không thể tải thông tin đơn hàng', 'error');
                    }
                },

                async checkExistingReview() {
                    try {
                        const response = await fetch(`/api/orderreviews/order/${this.orderId}`);
                        if (response.ok) {
                            const result = await response.json();
                            if (result.success && result.data) {
                                // Đã có review rồi
                                this.showToast('Đơn hàng này đã được đánh giá', 'error');
                                setTimeout(() => window.location.href = '/Order/MyOrders', 2000);
                            }
                        }
                    } catch (error) {
                        // Chưa có review, OK
                    }
                },

                selectRating(type, value) {
                    if (type === 'order') {
                        this.orderRating = value;
                    } else if (type === 'driver') {
                        this.driverRating = value;
                    }
                },

                handleImageUpload(event) {
                    const files = Array.from(event.target.files);
                    const remaining = 5 - this.images.length;
                    
                    files.slice(0, remaining).forEach(file => {
                        if (file.type.startsWith('image/')) {
                            const reader = new FileReader();
                            reader.onload = (e) => {
                                this.images.push(e.target.result);
                            };
                            reader.readAsDataURL(file);
                        }
                    });

                    event.target.value = ''; // Reset input
                },

                removeImage(index) {
                    this.images.splice(index, 1);
                },

                async submitReview() {
                    if (this.orderRating === 0) {
                        this.showToast('Vui lòng đánh giá đơn hàng', 'error');
                        return;
                    }

                    if (this.comment.length > 500) {
                        this.showToast('Nhận xét không được vượt quá 500 ký tự', 'error');
                        return;
                    }

                    this.submitting = true;

                    try {
                        const payload = {
                            orderId: this.orderId,
                            orderRating: this.orderRating,
                            driverRating: this.order.driverId ? this.driverRating : null,
                            comment: this.comment,
                            images: this.images
                        };

                        const response = await fetch('/api/orderreviews', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });

                        const result = await response.json();
                        
                        if (result.success) {
                            this.showToast('Cảm ơn bạn đã đánh giá!', 'success');
                            setTimeout(() => window.location.href = '/Order/MyOrders', 1500);
                        } else {
                            this.showToast(result.message, 'error');
                        }
                    } catch (error) {
                        console.error('Submit review error:', error);
                        this.showToast('Không thể gửi đánh giá', 'error');
                    } finally {
                        this.submitting = false;
                    }
                },

                formatMoney(amount) {
                    return new Intl.NumberFormat('vi-VN', {
                        style: 'currency',
                        currency: 'VND'
                    }).format(amount);
                },

                showToast(message, type = 'success') {
                    this.toast = { show: true, message, type };
                    setTimeout(() => {
                        this.toast.show = false;
                    }, 3000);
                }
            };
        }
    </script>
</body>
</html>
