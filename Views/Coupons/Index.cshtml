@{
    ViewData["Title"] = ViewBag.Coupons;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main>
  <div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3 class="h4 mb-0">@ViewBag.Coupons</h3>
      <a class="btn btn-outline-primary" href="/shop">@ViewBag.ShopNow</a>
    </div>
    <div id="couponsGrid" class="row g-3"></div>
  </div>
</main>

<script>
document.addEventListener('DOMContentLoaded', async () => {
  const grid = document.getElementById('couponsGrid');
  try {
    const res = await fetch('/api/coupons/active');
    const json = await res.json();
    const list = json.data || [];
    if (list.length === 0) {
      grid.innerHTML = '<div class="col-12"><div class="alert alert-info">@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.CouponNoData)</div></div>';
      return;
    }
    grid.innerHTML='';
    for (const c of list) {
      const col = document.createElement('div');
      col.className = 'col-12 col-md-6 col-lg-4';
      const val = c.type === 1 ? (c.value + '%') : (new Intl.NumberFormat(navigator.language, { style: 'currency', currency: 'VND' }).format(c.value));
      const period = new Date(c.startAt).toLocaleDateString(navigator.language) + ' - ' + new Date(c.endAt).toLocaleDateString(navigator.language);
      col.innerHTML = `
        <div class="card h-100">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="card-title mb-0">${c.name}</h5>
              <span class="badge bg-light-primary text-dark-primary">${val}</span>
            </div>
            <div class="small text-muted mb-2">${period}</div>
            <div class="small mb-2">@ViewBag.CouponRemaining: <strong>${c.remaining}</strong></div>
            <div class="input-group mt-auto">
              <input type="text" class="form-control" value="${c.code}" readonly>
              <button class="btn btn-outline-secondary" data-code="${c.code}">@ViewBag.Copy</button>
            </div>
          </div>
        </div>`;
      grid.appendChild(col);
    }
    grid.addEventListener('click', async (e) => {
      const btn = e.target.closest('button[data-code]');
      if (!btn) return;
      const code = btn.getAttribute('data-code');
      try { await navigator.clipboard.writeText(code); btn.textContent = '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.Copied)'; setTimeout(()=> btn.textContent = '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.Copy)', 1500);} catch {}
    });
  } catch (e) {
    grid.innerHTML = '<div class="col-12"><div class="alert alert-danger">@ViewBag.GenericError</div></div>';
  }
});
</script>
