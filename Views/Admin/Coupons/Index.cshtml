@model List<CouponViewModel>
@{
    ViewData["Title"] = ViewBag.CouponTitle;
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="row mb-8">
    <div class="col-md-12">
        <!-- page header -->
        <div class="d-md-flex justify-content-between align-items-center">
            <div>
                <h2>@ViewBag.CouponTitle</h2>
                <!-- breadcrumb -->
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")"
                                class="text-inherit">@ViewBag.Dashboard</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@ViewBag.CouponTitle</li>
                    </ol>
                </nav>
            </div>
            <!-- button -->
            <div>
                <a href="@Url.Action("Create", "Coupons")" class="btn btn-primary">@ViewBag.CouponAddNew</a>
            </div>
        </div>
    </div>
</div>

<!-- row -->
<div class="row">
    <div class="col-xl-12 col-12 mb-5">
        <!-- card -->
        <div class="card h-100 card-lg">
            <div class="px-6 py-6">
                <div class="row justify-content-between">
                    <!-- form -->
                    <div class="col-lg-4 col-md-6 col-12 mb-2 mb-lg-0">
                        <form class="d-flex" role="search">
                            <input class="form-control" type="search" placeholder="@ViewBag.CouponSearch"
                                aria-label="Search" />
                        </form>
                    </div>
                    <!-- select option -->
                    <div class="col-lg-2 col-md-4 col-12">
                        <select class="form-select">
                            <option selected>@ViewBag.CouponStatus</option>
                            <option value="1">@ViewBag.CouponActive</option>
                            <option value="0">@ViewBag.CouponInactive</option>
                        </select>
                    </div>
                </div>
            </div>
            <!-- card body -->
            <div class="card-body p-0">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mx-6 mb-0" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mx-6 mb-0" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                <!-- table -->
                <div class="table-responsive">
                    <table class="table table-centered table-hover text-nowrap table-borderless mb-0 table-with-checkbox">
                        <thead class="bg-light">
                            <tr>
                                <th>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="" id="checkAll" />
                                        <label class="form-check-label" for="checkAll"></label>
                                    </div>
                                </th>
                                <th>@ViewBag.CouponCode</th>
                                <th>@ViewBag.CouponName</th>
                                <th>@ViewBag.CouponPeriod</th>
                                <th>@ViewBag.CouponUsage</th>
                                <th>@ViewBag.CouponStatus</th>
                                <th>@ViewBag.TableHeaderActions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var coupon in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" value="@coupon.Id" />
                                                <label class="form-check-label"></label>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div>
                                                    <span class="fw-semibold">@coupon.Code</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="text-reset">@coupon.Name</span>
                                            @if (!string.IsNullOrEmpty(coupon.Description))
                                            {
                                                <br><small class="text-muted">@coupon.Description</small>
                                            }
                                        </td>
                                        <td>
                                            <div>
                                                <small class="text-muted">@ViewBag.CouponStart:</small>
                                                <span class="d-block">@coupon.StartAt.ToString("dd/MM/yyyy")</span>
                                                <small class="text-muted">@ViewBag.CouponEnd:</small>
                                                <span class="d-block">@coupon.EndAt.ToString("dd/MM/yyyy")</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column">
                                                <span class="fw-semibold">@coupon.UsedCount/@coupon.Total</span>
                                                <div class="progress mt-1" style="height: 4px;">
                                                    <div class="progress-bar bg-primary" role="progressbar" 
                                                         style="width: @((double)coupon.UsedCount / coupon.Total * 100)%"></div>
                                                </div>
                                                <small class="text-muted">@ViewBag.CouponRemaining: @coupon.RemainingCount</small>
                                            </div>
                                        </td>
                                        <td>
                                            @if (coupon.IsActive)
                                            {
                                                <span class="badge bg-light-primary text-primary">@ViewBag.CouponActive</span>
                                            }
                                            else if (coupon.Status == 0)
                                            {
                                                <span class="badge bg-light-secondary text-dark">@ViewBag.CouponInactive</span>
                                            }
                                            else if (DateTime.Now < coupon.StartAt)
                                            {
                                                <span class="badge bg-light-warning text-warning">@ViewBag.CouponPending</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light-danger text-danger">@ViewBag.CouponExpired</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="dropdown">
                                                <a href="#" class="text-reset" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="feather-icon icon-more-vertical fs-5"></i>
                                                </a>
                                                <ul class="dropdown-menu">
                                                    <li>
                                                        <a class="dropdown-item" href="@Url.Action("Edit", "Coupons", new { id = coupon.Id })">
                                                            <i class="bi bi-pencil-square me-3"></i>@ViewBag.CouponEdit
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <form method="post" action="@Url.Action("ToggleStatus", "Coupons")" class="d-inline">
                                                            <input type="hidden" name="id" value="@coupon.Id" />
                                                            <button type="submit" class="dropdown-item">
                                                                <i class="bi @(coupon.Status == 1 ? "bi-pause-circle" : "bi-play-circle") me-3"></i>
                                                                @(coupon.Status == 1 ? ViewBag.CouponDeactivate : ViewBag.CouponActivate)
                                                            </button>
                                                        </form>
                                                    </li>
                                                    <li><hr class="dropdown-divider" /></li>
                                                    <li>
                                                        <form method="post" action="@Url.Action("Delete", "Coupons")" class="d-inline" 
                                                              onsubmit="return confirm('@ViewBag.CouponDeleteConfirm')">
                                                            <input type="hidden" name="id" value="@coupon.Id" />
                                                            <button type="submit" class="dropdown-item text-danger">
                                                                <i class="bi bi-trash me-3"></i>@ViewBag.CouponDelete
                                                            </button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-5">
                                        <div class="text-muted">
                                            <i class="bi bi-inbox fs-1"></i>
                                            <p class="mt-3">@ViewBag.CouponNoData</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
