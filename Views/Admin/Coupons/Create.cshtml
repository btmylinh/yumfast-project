@model CouponViewModel
@{
    ViewData["Title"] = ViewBag.CouponAddNew;
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- row -->
<div class="row mb-8">
    <div class="col-md-12">
        <div class="d-md-flex justify-content-between align-items-center">
            <!-- page header -->
            <div>
                <h2>@ViewBag.CouponAddNew</h2>
                <!-- breadcrumb -->
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-inherit">@ViewBag.Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Coupons")" class="text-inherit">@ViewBag.CouponTitle</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@ViewBag.CouponAddNew</li>
                    </ol>
                </nav>
            </div>
            <!-- button -->
            <div>
                <a href="@Url.Action("Index", "Coupons")" class="btn btn-light">@ViewBag.CouponBackToList</a>
            </div>
        </div>
    </div>
</div>

<form asp-action="Create" method="post">
    <!-- row -->
    <div class="row">
        <div class="col-lg-8 col-12">
            <!-- card -->
            <div class="card mb-6 card-lg">
                <!-- card body -->
                <div class="card-body p-6">
                    <h4 class="mb-4 h5">@ViewBag.CouponBasicInfo</h4>
                    
                    <!-- Validation Summary -->
                    <div asp-validation-summary="All" class="alert alert-danger d-none"></div>
                    
                    <div class="row">
                        <!-- Coupon Code -->
                        <div class="mb-3 col-lg-6">
                            <label asp-for="Code" class="form-label">@ViewBag.CouponCode</label>
                            <div class="input-group">
                                <input asp-for="Code" class="form-control" placeholder="@ViewBag.CouponCodePlaceholder">
                                <button type="button" class="btn btn-outline-secondary" id="btn-gen-code">@ViewBag.Create</button>
                            </div>
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>
                        
                        <!-- Coupon Name -->
                        <div class="mb-3 col-lg-6">
                            <label asp-for="Name" class="form-label">@ViewBag.CouponName</label>
                            <input asp-for="Name" class="form-control" placeholder="@ViewBag.CouponNamePlaceholder">
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        
                        <!-- Type -->
                        <div class="mb-3 col-lg-6">
                            <label asp-for="Type" class="form-label">@ViewBag.CouponType</label>
                            <select asp-for="Type" class="form-select">
                                <option value="">@ViewBag.CouponSelectType</option>
                                <option value="1">@ViewBag.CouponPercentage</option>
                                <option value="2">@ViewBag.CouponFixedAmount</option>
                            </select>
                            <span asp-validation-for="Type" class="text-danger"></span>
                        </div>
                        
                        <!-- Value -->
                        <div class="mb-3 col-lg-6">
                            <label asp-for="Value" class="form-label">@ViewBag.CouponValue</label>
                            <div class="input-group">
                                <input asp-for="Value" type="number" class="form-control" placeholder="@ViewBag.CouponValuePlaceholder">
                                <span class="input-group-text" id="value-unit">@ViewBag.CouponValueUnit</span>
                            </div>
                            <span asp-validation-for="Value" class="text-danger"></span>
                        </div>
                        
                        <!-- Start Date -->
                        <div class="mb-3 col-lg-6">
                            <label asp-for="StartAt" class="form-label">@ViewBag.CouponStartDate</label>
                            <input asp-for="StartAt" type="datetime-local" class="form-control">
                            <span asp-validation-for="StartAt" class="text-danger"></span>
                        </div>
                        
                        <!-- End Date -->
                        <div class="mb-3 col-lg-6">
                            <label asp-for="EndAt" class="form-label">@ViewBag.CouponEndDate</label>
                            <input asp-for="EndAt" type="datetime-local" class="form-control">
                            <span asp-validation-for="EndAt" class="text-danger"></span>
                        </div>
                        
                        <!-- Total Quantity -->
                        <div class="mb-3 col-lg-6">
                            <label asp-for="Total" class="form-label">@ViewBag.CouponTotalQuantity</label>
                            <input asp-for="Total" type="number" class="form-control" placeholder="@ViewBag.CouponTotalPlaceholder" min="1">
                            <span asp-validation-for="Total" class="text-danger"></span>
                        </div>
                        
                        <!-- Product ID (Optional) -->
                        <div class="mb-3 col-lg-6">
                            <label asp-for="IdProduct" class="form-label">@ViewBag.CouponProductOptional</label>
                            <select asp-for="IdProduct" class="form-select">
                                <option value="">@ViewBag.CouponAllProducts</option>
                            </select>
                            <small class="form-text text-muted">@ViewBag.CouponProductNote</small>
                        </div>
                        
                        <!-- Description -->
                        <div class="mb-3 col-12">
                            <label asp-for="Description" class="form-label">@ViewBag.CouponDescription</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="@ViewBag.CouponDescriptionPlaceholder"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4 col-12">
            <!-- card -->
            <div class="card mb-6 card-lg">
                <!-- card body -->
                <div class="card-body p-6">
                    <h4 class="mb-4 h5">@ViewBag.CouponSettings</h4>
                    
                    <!-- Status -->
                    <div class="mb-4">
                        <label asp-for="Status" class="form-label">@ViewBag.CouponStatus</label>
                        <select asp-for="Status" class="form-select">
                            <option value="1">@ViewBag.CouponActive</option>
                            <option value="0">@ViewBag.CouponInactive</option>
                        </select>
                    </div>
                    
                    <!-- Preview Card -->
                    <div class="border rounded-3 p-4 bg-light">
                        <h6 class="mb-3">@ViewBag.CouponPreview</h6>
                        <div class="d-flex align-items-center justify-content-between bg-white rounded p-3 border">
                            <div>
                                <div class="fw-bold text-primary" id="preview-code">@ViewBag.CouponCodePreview</div>
                                <small class="text-muted" id="preview-name">@ViewBag.CouponNamePreview</small>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-success" id="preview-value">@ViewBag.CouponValuePreview</div>
                                <small class="text-muted" id="preview-type">@ViewBag.CouponTypePreview</small>
                            </div>
                        </div>
                        <div class="mt-2 text-center">
                            <small class="text-muted">
                                <span id="preview-period">@ViewBag.CouponPeriodPreview</span>
                            </small>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Action buttons -->
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-2"></i>@ViewBag.CouponSave
                </button>
                <a href="@Url.Action("Index", "Coupons")" class="btn btn-secondary">
                    <i class="bi bi-x-circle me-2"></i>@ViewBag.CouponCancel
                </a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Update preview when form changes
            const form = document.querySelector('form');
            const previewCode = document.getElementById('preview-code');
            const previewName = document.getElementById('preview-name');
            const previewValue = document.getElementById('preview-value');
            const previewType = document.getElementById('preview-type');
            const previewPeriod = document.getElementById('preview-period');
            const valueUnit = document.getElementById('value-unit');
            
            function updatePreview() {
                const code = document.getElementById('Code').value || '@ViewBag.CouponCodePreview';
                const name = document.getElementById('Name').value || '@ViewBag.CouponNamePreview';
                const type = document.getElementById('Type').value;
                const value = document.getElementById('Value').value;
                const startDate = document.getElementById('StartAt').value;
                const endDate = document.getElementById('EndAt').value;
                
                previewCode.textContent = code;
                previewName.textContent = name;
                
                if (type && value) {
                    if (type === '1') {
                        previewValue.textContent = value + '%';
                        previewType.textContent = '@ViewBag.CouponPercentage';
                        valueUnit.textContent = '%';
                    } else if (type === '2') {
                        previewValue.textContent = new Intl.NumberFormat('vi-VN').format(value) + ' VNĐ';
                        previewType.textContent = '@ViewBag.CouponFixedAmount';
                        valueUnit.textContent = 'VNĐ';
                    }
                } else {
                    previewValue.textContent = '@ViewBag.CouponValuePreview';
                    previewType.textContent = '@ViewBag.CouponTypePreview';
                    valueUnit.textContent = '@ViewBag.CouponValueUnit';
                }
                
                if (startDate && endDate) {
                    const start = new Date(startDate).toLocaleDateString('vi-VN');
                    const end = new Date(endDate).toLocaleDateString('vi-VN');
                    previewPeriod.textContent = `${start} - ${end}`;
                } else {
                    previewPeriod.textContent = '@ViewBag.CouponPeriodPreview';
                }
            }
            
            // Add event listeners
            form.addEventListener('input', updatePreview);
            form.addEventListener('change', updatePreview);
            
            // Initial update
            updatePreview();
            
            // Form validation
            form.addEventListener('submit', function(e) {
                const startDate = new Date(document.getElementById('StartAt').value);
                const endDate = new Date(document.getElementById('EndAt').value);
                
                if (startDate >= endDate) {
                    e.preventDefault();
                    alert('@ViewBag.CouponDateError');
                    return false;
                }
                
                const value = parseInt(document.getElementById('Value').value);
                const type = document.getElementById('Type').value;
                
                if (type === '1' && (value <= 0 || value > 100)) {
                    e.preventDefault();
                    alert('@ViewBag.CouponPercentageError');
                    return false;
                }
                
                if (type === '2' && value <= 0) {
                    e.preventDefault();
                    alert('@ViewBag.CouponAmountError');
                    return false;
                }
            });

            function genRandomCode(len){ const chars='ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; let s=''; for(let i=0;i<len;i++){ s+=chars[Math.floor(Math.random()*chars.length)]; } return s; }
            const btnGen = document.getElementById('btn-gen-code'); if(btnGen){ btnGen.addEventListener('click', function(){ const inp=document.getElementById('Code'); if(inp){ inp.value=genRandomCode(8); updatePreview(); } }); }

            (async function loadProducts(){
                try{
                    const sel = document.getElementById('IdProduct');
                    if(!sel) return;
                    const r = await fetch('/api/products/manage?status=1&pageSize=500');
                    const j = await r.json();
                    const list = j.data || [];
                    const current = sel.value;
                    sel.innerHTML = '';
                    const optAll = document.createElement('option');
                    optAll.value = '';
                    optAll.textContent = '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.CouponAllProducts)';
                    sel.appendChild(optAll);
                    for(const p of list){
                        const opt = document.createElement('option');
                        opt.value = String(p.id);
                        opt.textContent = p.name;
                        sel.appendChild(opt);
                    }
                    sel.value = current || '';
                }catch(e){}
            })();
        });
    </script>
    
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
