										<form class="row g-3 needs-validation" novalidate>
											<div class="col-lg-6 col-12">
												<div>
													<!-- input -->
													<label for="userEditName" class="form-label">
														Name
														<span class="text-danger">*</span>
													</label>
													<input type="text" class="form-control" id="userEditName" placeholder="User Name" required />
													<div class="invalid-feedback">Please enter category name</div>
												</div>
											</div>
											<div class="col-lg-6 col-12">
												<div>
													<!-- input -->
													<label for="userEditEmail" class="form-label">
														Email
														<span class="text-danger">*</span>
													</label>
													<input type="email" class="form-control" id="userEditEmail" placeholder="Email Address" required />
													<div class="invalid-feedback">Please enter email</div>
												</div>
											</div>
											<div class="col-lg-6 col-12">
												<div>
													<!-- input -->
													<label for="userEditPhone" class="form-label">Phone</label>
													<input type="text" class="form-control" id="userEditPhone" placeholder="Number" required />
