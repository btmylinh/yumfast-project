@{
    ViewData["Title"] = "Thêm danh mục mới";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

    <!-- row -->
    <div class="row mb-8">
        <div class="col-md-12">
            <div class="d-md-flex justify-content-between align-items-center">
                <!-- page header -->
                <div>
                    <h2>Thêm danh mục mới</h2>
                    <!-- breadcrumb -->
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-inherit">Dashboard</a></li>
                            <li class="breadcrumb-item"><a href="@Url.Action("Categories", "Admin")" class="text-inherit">Danh mục</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
                        </ol>
                    </nav>
                </div>
                <!-- button -->
                <div>
                    <a href="@Url.Action("Categories", "Admin")" class="btn btn-light">Quay lại danh sách</a>
                </div>
            </div>
        </div>
    </div>
    <!-- row -->
    <div class="row justify-content-center" x-data="categoriesAdd()">
        <div class="col-lg-8 col-12">
            <!-- card -->
            <div class="card mb-6 card-lg">
                <!-- card body -->
                <div class="card-body p-6">
                    <h4 class="mb-4 h5">Thông tin danh mục</h4>
                    <form x-on:submit.prevent>
                        <div class="row">
                            <!-- input -->
                            <div class="mb-3 col-lg-6">
                                <label class="form-label">Tên danh mục <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" placeholder="Nhập tên danh mục" x-model="form.name" x-on:input="onNameInput()" required>
                            </div>
                            <!-- input -->
                            <div class="mb-3 col-lg-6">
                                <label class="form-label">Slug</label>
                                <input type="text" class="form-control" placeholder="ten-danh-muc" x-model="form.slug" x-on:input="generating=false">
                                <small class="text-muted">URL thân thiện (tự động tạo nếu để trống)</small>
                            </div>
                            <!-- input -->
                            <div class="mb-3 col-12">
                                <label class="form-label">Mô tả</label>
                                <textarea class="form-control" rows="4" placeholder="Nhập mô tả danh mục" x-model="form.description"></textarea>
                            </div>
                             <h4 class="mb-4 h5">Hiển thị</h4>
                            <div class="row">
                                <!-- switch -->
                                <div class="col-lg-6 mb-3">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" id="isActive" x-on:change="toggleActive($event)" checked>
                                        <label class="form-check-label" for="isActive">Kích hoạt</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
         
            <!-- buttons -->
            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-primary" x-on:click="create()">Tạo danh mục</button>
                <button type="button" class="btn btn-secondary" x-on:click="saveDraft()">Lưu nháp</button>
                <a href="@Url.Action("Categories", "Admin")" class="btn btn-light">Hủy</a>
            </div>
        </div>
    </div>

    <script>
    function categoriesAdd(){
      return {
        form:{ name:'', slug:'', description:'', status:1 },
        generating:true,
        normalizeSlug(s){ return String(s||'').toLowerCase().trim().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9\-\s]/g,'').replace(/\s+/g,'-').replace(/-+/g,'-'); },
        onNameInput(){ if(!this.form.slug || this.generating){ this.form.slug = this.normalizeSlug(this.form.name); } },
        toggleActive(e){ this.form.status = e.target.checked ? 1 : 0; },
        async create(){ const n=this.form.name.trim(), sl=this.form.slug.trim(); if(!n||!sl){ alert('@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.ValidationFillAll)'); return; } try{ const r=await fetch('/api/categories',{ method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(this.form) }); if(r.ok){ window.location.href='@Url.Action("Categories","Admin")'; } else { const j = await r.json().catch(()=>({})); alert(j.message || '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.GenericError)'); } } catch{ alert('@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode((string)ViewBag.GenericError)'); } },
        async saveDraft(){ this.form.status=0; await this.create(); }
      }
    }
    </script>
