@{
	ViewData["Title"] = "Order List";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}
					<!-- row -->
					<div class="row mb-8" x-data="orderDetailAdmin()" x-init="init()">
						<div class="col-md-12">
							<div
								class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4">
								<div>
									<!-- page header -->
									<h2>Order Single</h2>
									<!-- breacrumb -->
									<nav aria-label="breadcrumb">
										<ol class="breadcrumb mb-0">
											<li class="breadcrumb-item"><a href="/admin/Orders"
													class="text-inherit">Dashboard</a></li>
											<li class="breadcrumb-item active" aria-current="page">Chi tiết đơn hàng</li>
										</ol>
									</nav>
								</div>
								<!-- button -->
								<div>
									<a href="/admin/Orders" class="btn btn-primary">Quay lại danh sách</a>
								</div>
							</div>
						</div>
					</div>
					<!-- Loading State -->
					<template x-if="loading">
						<div class="row">
							<div class="col-12">
								<div class="card">
									<div class="card-body text-center py-5">
										<div class="spinner-border text-primary" role="status">
											<span class="visually-hidden">Đang tải...</span>
										</div>
										<p class="mt-3">Đang tải thông tin đơn hàng...</p>
									</div>
								</div>
							</div>
						</div>
					</template>
					<!-- Error State -->
					<template x-if="!loading && error">
						<div class="row">
							<div class="col-12">
								<div class="alert alert-danger">
									<h5>Lỗi tải dữ liệu</h5>
									<p x-text="errorMessage"></p>
									<a href="/admin/Orders" class="btn btn-secondary">Quay lại danh sách</a>
								</div>
							</div>
						</div>
					</template>
					<!-- Order Content -->
					<template x-if="!loading && !error && order">
						<div class="row">
							<div class="col-xl-12 col-12 mb-5">
								<!-- card -->
								<div class="card h-100 card-lg">
									<div class="card-body p-6">
										<div class="d-md-flex justify-content-between">
											<div class="d-flex align-items-center mb-2 mb-md-0">
												<h2 class="mb-0">Đơn hàng: <span x-text="order.code"></span></h2>
												<span class="badge ms-2" :class="statusBadgeClass(order.status)" x-text="statusText(order.status)"></span>
											</div>
											<!-- select option -->
											<div class="d-md-flex">
												<div class="mb-2 mb-md-0">
													<select class="form-select" x-model="newStatus" @@change="updateStatus()">
														<option :value="order.status" selected>Cập nhật trạng thái</option>
														<option value="0">Pending</option>
														<option value="1">Processing</option>
														<option value="2">Shipped</option>
														<option value="3">Delivered</option>
														<option value="4">Cancelled</option>
													</select>
												</div>
												<!-- button -->
												<div class="ms-md-3">
													<button class="btn btn-secondary" @@click="downloadInvoice()">Download Invoice</button>
												</div>
											</div>
										</div>
										<div class="mt-8">
											<div class="row">
												<!-- User Details -->
												<div class="col-lg-4 col-md-4 col-12">
													<div class="mb-6">
														<h6>Thông tin khách hàng</h6>
														<p class="mb-1 lh-lg">
															<span x-text="order.shipName || 'N/A'"></span>
															<br />
															<span x-text="order.email || 'N/A'"></span>
															<br />
															<span x-text="order.shipPhone || 'N/A'"></span>
														</p>
													</div>
												</div>
												<!-- Shipping Address -->
												<div class="col-lg-4 col-md-4 col-12">
													<div class="mb-6">
														<h6>Địa chỉ giao hàng</h6>
														<p class="mb-1 lh-lg" x-text="order.shipAddress || 'N/A'"></p>
													</div>
												</div>
												<!-- Order Details -->
												<div class="col-lg-4 col-md-4 col-12">
													<div class="mb-6">
														<h6>Thông tin đơn hàng</h6>
														<p class="mb-1 lh-lg">
															Mã đơn: <span class="text-dark" x-text="order.code"></span>
															<br />
															Ngày đặt: <span class="text-dark" x-text="formatDate(order.createdAt)"></span>
															<br />
															Tổng tiền: <span class="text-dark fw-bold" x-text="formatPrice(order.total)"></span>
														</p>
													</div>
												</div>
											</div>
										</div>
									</div>
									<div class="row">
										<div class="col-12">
											<div class="table-responsive">
												<!-- Table -->
												<table class="table mb-0 text-nowrap table-centered">
													<!-- Table Head -->
													<thead class="bg-light">
														<tr>
															<th>Sản phẩm</th>
															<th>Giá</th>
															<th>Số lượng</th>
															<th>Thành tiền</th>
														</tr>
													</thead>
													<!-- tbody -->
													<tbody>
														<template x-for="item in items" :key="item.productId">
															<tr>
																<td>
																	<a :href="`/product/${item.productId}`" class="text-inherit">
																		<div class="d-flex align-items-center">
																			<div class="ms-lg-4 mt-2 mt-lg-0">
																				<h5 class="mb-0 h6" x-text="item.name"></h5>
																			</div>
																		</div>
																	</a>
																</td>
																<td><span class="text-body" x-text="formatPrice(item.price)"></span></td>
																<td x-text="item.quantity"></td>
																<td x-text="formatPrice(item.total)"></td>
															</tr>
														</template>
														<tr>
															<td class="border-bottom-0 pb-0"></td>
															<td class="border-bottom-0 pb-0"></td>
															<td colspan="1" class="fw-medium text-dark">
																Tạm tính:
															</td>
															<td class="fw-medium text-dark" x-text="formatPrice(order.subtotal)"></td>
														</tr>
														<tr>
															<td class="border-bottom-0 pb-0"></td>
															<td class="border-bottom-0 pb-0"></td>
															<td colspan="1" class="fw-medium text-dark">
																Giảm giá:
															</td>
															<td class="fw-medium text-dark" x-text="formatPrice(order.discount)"></td>
														</tr>
														<tr>
															<td class="border-bottom-0 pb-0"></td>
															<td class="border-bottom-0 pb-0"></td>
															<td colspan="1" class="fw-medium text-dark">
																Phí vận chuyển:
															</td>
															<td class="fw-medium text-dark" x-text="formatPrice(order.shippingFee)"></td>
														</tr>
														<tr>
															<td></td>
															<td></td>
															<td colspan="1" class="fw-semibold text-dark">
																Tổng cộng:
															</td>
															<td class="fw-semibold text-dark" x-text="formatPrice(order.total)"></td>
														</tr>
													</tbody>
												</table>
											</div>
										</div>
									</div>
									<div class="card-body p-6">
										<div class="row">
											<div class="col-md-6 mb-4 mb-lg-0">
												<h6>Thông tin thanh toán</h6>
												<span x-text="paymentText(order.paymentStatus)"></span>
											</div>
											<div class="col-md-6">
												<h6>Lịch sử trạng thái</h6>
												<div class="mt-3">
													<template x-for="(h, index) in history" :key="index">
														<div class="mb-2">
															<small class="text-muted" x-text="formatDate(h.createdAt)"></small>
															<span class="badge ms-2" :class="statusBadgeClass(h.status)" x-text="statusText(h.status)"></span>
															<span x-show="h.note" class="ms-2" x-text="h.note"></span>
														</div>
													</template>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</template>

					<!-- Review Section -->
					<div class="row mt-5" x-data="orderReviewApp()" x-init="init()" x-show="!loading && !error">
						<div class="col-xl-12 col-12">
							<div class="card">
								<div class="card-header">
									<h4 class="mb-0">Đánh giá đơn hàng</h4>
								</div>
								
								<!-- Loading -->
								<template x-if="loading">
									<div class="card-body text-center py-5">
										<div class="spinner-border text-primary" role="status">
											<span class="visually-hidden">Đang tải...</span>
										</div>
									</div>
								</template>
								
								<!-- No Review -->
								<template x-if="!loading && !reviewData">
									<div class="card-body text-center py-5 text-muted">
										<i class="bi bi-chat-left-text fs-1 mb-3"></i>
										<p>Chưa có đánh giá cho đơn hàng này</p>
									</div>
								</template>
								
								<!-- Review Content -->
								<template x-if="!loading && reviewData">
									<div class="card-body p-6">
										<!-- Stats Overview -->
										<div class="row mb-4">
											<div class="col-md-3 mb-3">
												<div class="text-center p-3 bg-light rounded">
													<h3 class="mb-1" x-text="reviewData.orderReview.orderRating"></h3>
													<div>
														<template x-for="i in 5" :key="i">
															<i class="bi" :class="i <= reviewData.orderReview.orderRating ? 'bi-star-fill text-warning' : 'bi-star text-muted'"></i>
														</template>
													</div>
													<small class="text-muted">Đánh giá đơn hàng</small>
												</div>
											</div>
											<div class="col-md-3 mb-3" x-show="reviewData.orderReview.driverRating">
												<div class="text-center p-3 bg-light rounded">
													<h3 class="mb-1" x-text="reviewData.orderReview.driverRating"></h3>
													<div>
														<template x-for="i in 5" :key="i">
															<i class="bi" :class="i <= reviewData.orderReview.driverRating ? 'bi-star-fill text-info' : 'bi-star text-muted'"></i>
														</template>
													</div>
													<small class="text-muted">Đánh giá tài xế</small>
												</div>
											</div>
											<div class="col-md-3 mb-3">
												<div class="text-center p-3 bg-light rounded">
													<h3 class="mb-1" x-text="reviewData.stats.averageProductRating"></h3>
													<div>
														<template x-for="i in 5" :key="i">
															<i class="bi" :class="i <= Math.round(reviewData.stats.averageProductRating) ? 'bi-star-fill text-warning' : 'bi-star text-muted'"></i>
														</template>
													</div>
													<small class="text-muted">TB sản phẩm</small>
												</div>
											</div>
											<div class="col-md-3 mb-3">
												<div class="text-center p-3 bg-light rounded">
													<h3 class="mb-1" x-text="reviewData.stats.totalProducts"></h3>
													<small class="text-muted">Sản phẩm đã đánh giá</small>
												</div>
											</div>
										</div>
										
										<!-- Order Review Detail -->
										<div class="mb-4">
											<h5 class="mb-3">Đánh giá tổng quan</h5>
											<div class="d-flex mb-3">
												<img :src="reviewData.orderReview.userAvatar || '/assets/images/avatar-default.jpg'" 
													 class="rounded-circle me-3" 
													 style="width: 50px; height: 50px; object-fit: cover;">
												<div class="flex-grow-1">
													<h6 class="mb-1" x-text="reviewData.orderReview.userName"></h6>
													<small class="text-muted" x-text="formatDate(reviewData.orderReview.createdAt)"></small>
												</div>
											</div>
											<p class="mb-3" x-text="reviewData.orderReview.comment || 'Không có nhận xét'"></p>
											
											<!-- Review Images -->
											<template x-if="reviewData.orderReview.images && reviewData.orderReview.images.length > 0">
												<div class="mb-3">
													<div class="row g-2">
														<template x-for="(img, index) in reviewData.orderReview.images" :key="index">
															<div class="col-auto">
																<img :src="img" 
																	 class="rounded" 
																	 style="width: 100px; height: 100px; object-fit: cover; cursor: pointer;"
																	 @@click="viewImage(img)">
															</div>
														</template>
													</div>
												</div>
											</template>
											
											<!-- Admin Reply -->
											<template x-if="reviewData.orderReview.adminReply">
												<div class="alert alert-info">
													<strong>Phản hồi từ Admin:</strong>
													<p class="mb-0 mt-2" x-text="reviewData.orderReview.adminReply"></p>
													<small class="text-muted" x-text="'Phản hồi lúc: ' + formatDate(reviewData.orderReview.adminRepliedAt)"></small>
												</div>
											</template>
										</div>
										
										<!-- Product Reviews -->
										<template x-if="reviewData.productReviews && reviewData.productReviews.length > 0">
											<div>
												<h5 class="mb-3">Đánh giá sản phẩm</h5>
												<template x-for="(review, index) in reviewData.productReviews" :key="review.id">
													<div class="border rounded p-3 mb-3">
														<div class="d-flex align-items-start">
															<img :src="getProductImage(review.productImages)" 
																 class="rounded me-3" 
																 style="width: 60px; height: 60px; object-fit: cover;">
															<div class="flex-grow-1">
																<h6 class="mb-1" x-text="review.productName"></h6>
																<div class="mb-2">
																	<template x-for="i in 5" :key="i">
																		<i class="bi" :class="i <= review.rating ? 'bi-star-fill text-warning' : 'bi-star text-muted'"></i>
																	</template>
																	<span class="ms-2 text-muted" x-text="review.rating + '/5'"></span>
																</div>
																<p class="mb-1" x-text="review.comment || 'Không có nhận xét'"></p>
																<small class="text-muted" x-text="formatDate(review.createdAt)"></small>
																<span class="badge ms-2" 
																	  :class="review.status === 1 ? 'bg-success' : 'bg-warning'"
																	  x-text="review.status === 1 ? 'Đã duyệt' : 'Chờ duyệt'"></span>
															</div>
														</div>
													</div>
												</template>
											</div>
										</template>
									</div>
								</template>
							</div>
						</div>
					</div>

<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
<script>
	function orderDetailAdmin() {
		return {
			loading: false,
			error: false,
			errorMessage: '',
			order: null,
			items: [],
			history: [],
			orderId: null,
			newStatus: null,

			async init() {
				const urlParams = new URLSearchParams(window.location.search);
				this.orderId = urlParams.get('id');
				if (this.orderId) {
					await this.loadOrder();
				} else {
					this.error = true;
					this.errorMessage = 'Không tìm thấy ID đơn hàng';
				}
			},

			async loadOrder() {
				this.loading = true;
				this.error = false;
				try {
					const token = localStorage.getItem('token') || localStorage.getItem('auth_token');
					const response = await fetch(`/api/orders/${this.orderId}`, {
						headers: {
							'Authorization': `Bearer ${token}`
						}
					});

					if (!response.ok) {
						if (response.status === 404) {
							this.error = true;
							this.errorMessage = 'Không tìm thấy đơn hàng';
						} else if (response.status === 403) {
							this.error = true;
							this.errorMessage = 'Bạn không có quyền xem đơn hàng này';
						} else {
							this.error = true;
							this.errorMessage = 'Lỗi khi tải dữ liệu đơn hàng';
						}
						return;
					}

					const result = await response.json();
					if (result.data) {
						this.order = result.data.order;
						this.items = result.data.items || [];
						this.history = result.data.history || [];
						this.newStatus = this.order.status;
					}
				} catch (e) {
					this.error = true;
					this.errorMessage = 'Lỗi kết nối máy chủ: ' + e.message;
					console.error('Load order error:', e);
				} finally {
					this.loading = false;
				}
			},

			async updateStatus() {
				if (!this.newStatus || this.newStatus == this.order.status) return;
				
				const note = prompt('Ghi chú (tuỳ chọn):', '');
				try {
					const token = localStorage.getItem('token') || localStorage.getItem('auth_token');
					const response = await fetch(`/api/orders/${this.orderId}/status`, {
						method: 'PATCH',
						headers: {
							'Content-Type': 'application/json',
							'Authorization': `Bearer ${token}`
						},
						body: JSON.stringify({ 
							status: parseInt(this.newStatus), 
							note: note || null 
						})
					});

					if (response.ok) {
						await this.loadOrder(); // Reload để lấy dữ liệu mới
						alert('Cập nhật trạng thái thành công');
					} else {
						const result = await response.json().catch(() => ({}));
						alert(result.message || 'Cập nhật trạng thái thất bại');
					}
				} catch (e) {
					alert('Lỗi kết nối máy chủ');
					console.error('Update status error:', e);
				}
			},

			formatPrice(v) {
				try {
					return new Intl.NumberFormat('vi-VN', {
						style: 'currency',
						currency: 'VND'
					}).format(v);
				} catch {
					return String(v);
				}
			},

			formatDate(dateStr) {
				if (!dateStr) return '';
				try {
					const date = new Date(dateStr);
					return date.toLocaleString('vi-VN', {
						year: 'numeric',
						month: '2-digit',
						day: '2-digit',
						hour: '2-digit',
						minute: '2-digit'
					});
				} catch {
					return String(dateStr);
				}
			},

			statusText(st) {
				switch(parseInt(st)) {
					case 0: return 'Pending';
					case 1: return 'Processing';
					case 2: return 'Shipped';
					case 3: return 'Delivered';
					case 4: return 'Cancelled';
					default: return String(st);
				}
			},

			statusBadgeClass(st) {
				switch(parseInt(st)) {
					case 0: return 'bg-light-warning text-dark-warning';
					case 1: return 'bg-light-primary text-dark-primary';
					case 2: return 'bg-light-info text-dark-info';
					case 3: return 'bg-light-success text-dark-success';
					case 4: return 'bg-light-danger text-dark-danger';
					default: return 'bg-light-secondary text-dark';
				}
			},

			paymentText(p) {
				switch(parseInt(p)) {
					case 1: return 'Đã thanh toán';
					case 2: return 'Đã hoàn tiền';
					default: return 'Chưa thanh toán';
				}
			},

			downloadInvoice() {
				alert('Tính năng xuất hóa đơn đang được phát triển');
			}
		};
	}

	function orderReviewApp() {
		return {
			loading: false,
			reviewData: null,
			orderId: null,

			async init() {
				// Lấy orderId từ URL params hoặc element attribute
				const urlParams = new URLSearchParams(window.location.search);
				this.orderId = urlParams.get('orderId') || urlParams.get('id');
				
				if (this.orderId) {
					await this.loadReview();
				}
			},

			async loadReview() {
				this.loading = true;
				try {
					const response = await fetch(`/api/orderreviews/order/${this.orderId}/details`);
					if (response.ok) {
						const result = await response.json();
						if (result.success) {
							this.reviewData = result.data;
							console.log('Review data loaded:', this.reviewData);
						}
					}
				} catch (error) {
					console.error('Load review error:', error);
				} finally {
					this.loading = false;
				}
			},

			formatDate(dateStr) {
				if (!dateStr) return '';
				const date = new Date(dateStr);
				return date.toLocaleDateString('vi-VN', {
					year: 'numeric',
					month: '2-digit',
					day: '2-digit',
					hour: '2-digit',
					minute: '2-digit'
				});
			},

			getProductImage(images) {
				if (!images) return '/assets/images/product-default.jpg';
				if (Array.isArray(images) && images.length > 0) return images[0];
				if (typeof images === 'string') {
					try {
						const parsed = JSON.parse(images);
						return parsed[0] || '/assets/images/product-default.jpg';
					} catch {
						return images;
					}
				}
				return '/assets/images/product-default.jpg';
			},

			viewImage(src) {
				// Open image in modal or new tab
				window.open(src, '_blank');
			}
		};
	}
</script>
