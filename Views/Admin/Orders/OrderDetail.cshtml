												</div>
											</div>
											<div class="col-md-3 mb-3">
												<div class="text-center p-3 bg-light rounded">
													<h3 class="mb-1" x-text="reviewData.stats.totalProducts"></h3>
													<small class="text-muted">Sản phẩm đã đánh giá</small>
												</div>
											</div>
										</div>
										
										<!-- Order Review Detail -->
										<div class="mb-4">
											<h5 class="mb-3">Đánh giá tổng quan</h5>
											<div class="d-flex mb-3">
												<img :src="reviewData.orderReview.userAvatar || '/assets/images/avatar-default.jpg'" 
													 class="rounded-circle me-3" 
													 style="width: 50px; height: 50px; object-fit: cover;">
												<div class="flex-grow-1">
