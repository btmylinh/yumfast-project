@{
	ViewData["Title"] = ViewBag.OrderTitle;
	Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}
<!-- row -->
<div class="row mb-8">
	<div class="col-md-12">
		<!-- page header -->
		<div>
			<h2>@ViewBag.OrderTitle</h2>
			<!-- breacrumb -->
			<nav aria-label="breadcrumb">
				<ol class="breadcrumb mb-0">
					<li class="breadcrumb-item"><a href="#">@ViewBag.Dashboard</a></li>
					<li class="breadcrumb-item active" aria-current="page">@ViewBag.OrderTitle</li>
				</ol>
			</nav>
                </div>
            </div>
            <!-- Statistics Cards -->
            <div x-data="ordersAdmin()" x-init="init()">
            <div class="row mb-4" x-show="stats">
                <div class="col-xl-3 col-md-6 col-12 mb-4">
                    <div class="card border-0 bg-light-primary">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h6 class="text-muted mb-2">Tổng đơn hàng</h6>
                                    <h2 class="mb-0" x-text="stats ? stats.total : 0"></h2>
                                </div>
                                <div class="icon-shape icon-md bg-primary text-white rounded">
                                    <i class="bi bi-cart-check fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 col-12 mb-4">
                    <div class="card border-0 bg-light-warning">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h6 class="text-muted mb-2">Đơn hàng mới</h6>
                                    <h2 class="mb-0" x-text="stats ? stats.newOrders : 0"></h2>
                                </div>
                                <div class="icon-shape icon-md bg-warning text-white rounded">
                                    <i class="bi bi-clock-history fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 col-12 mb-4">
                    <div class="card border-0 bg-light-info">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h6 class="text-muted mb-2">Đang xử lý</h6>
                                    <h2 class="mb-0" x-text="stats ? stats.processing : 0"></h2>
                                </div>
                                <div class="icon-shape icon-md bg-info text-white rounded">
                                    <i class="bi bi-gear fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 col-12 mb-4">
                    <div class="card border-0 bg-light-success">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h6 class="text-muted mb-2">Đã giao</h6>
                                    <h2 class="mb-0" x-text="stats ? stats.delivered : 0"></h2>
                                </div>
                                <div class="icon-shape icon-md bg-success text-white rounded">
                                    <i class="bi bi-check-circle fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Additional Statistics Row -->
            <div class="row mb-4" x-show="stats">
                <div class="col-xl-3 col-md-6 col-12 mb-4">
                    <div class="card border-0 bg-light-danger">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h6 class="text-muted mb-2">Đã hủy</h6>
                                    <h2 class="mb-0" x-text="stats ? stats.cancelled : 0"></h2>
                                </div>
                                <div class="icon-shape icon-md bg-danger text-white rounded">
                                    <i class="bi bi-x-circle fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 col-12 mb-4">
                    <div class="card border-0 bg-light-primary">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h6 class="text-muted mb-2">Doanh thu</h6>
                                    <h2 class="mb-0" x-text="stats ? formatPrice(stats.revenue) : formatPrice(0)"></h2>
                                </div>
                                <div class="icon-shape icon-md bg-primary text-white rounded">
                                    <i class="bi bi-currency-dollar fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 col-12 mb-4">
                    <div class="card border-0 bg-light-info">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <h6 class="text-muted mb-2">Đơn hôm nay</h6>
                                    <h2 class="mb-0" x-text="stats ? stats.todayOrders : 0"></h2>
                                </div>
                                <div class="icon-shape icon-md bg-info text-white rounded">
                                    <i class="bi bi-calendar-day fs-4"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            </div>
            <div class="card-body p-0" x-data="ordersAdmin()" x-init="init()">
                <div class="px-6 pb-3">
                    <!-- Basic Filters Row -->
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                        <input class="form-control" type="search" placeholder="Tìm mã đơn / sđt / email" x-model="search" x-on:input.debounce.500ms="load()" style="max-width:420px" />
                        <select class="form-select" x-model="status" x-on:change="load()" style="max-width:200px">
                            <option value="">@ViewBag.OrderStatus</option>
                            <option value="0">Pending</option>
                            <option value="1">Processing</option>
                            <option value="2">Shipped</option>
                            <option value="3">Delivered</option>
                            <option value="4">Cancelled</option>
                        </select>
                        <select class="form-select" x-model="paymentMethod" x-on:change="load()" style="max-width:200px">
                            <option value="">Tất cả phương thức</option>
                            <option value="COD">COD</option>
                            <option value="VNPAY">VNPay</option>
                            <option value="MOMO">MoMo</option>
                        </select>
                        <button class="btn btn-outline-secondary" @@click="toggleAdvancedFilters()">
                            <i class="bi bi-funnel"></i> Lọc nâng cao
                        </button>
                        <button class="btn btn-outline-primary" @@click="load()">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                        <div class="dropdown">
                            <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-download"></i> Export
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#" @@click.prevent="exportOrders('excel')">
                                    <i class="bi bi-file-earmark-excel me-2"></i> Export Excel
                                </a></li>
                                <li><a class="dropdown-item" href="#" @@click.prevent="exportOrders('csv')">
                                    <i class="bi bi-filetype-csv me-2"></i> Export CSV
                                </a></li>
                            </ul>
                        </div>
                    </div>
                    <!-- Advanced Filters Row -->
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-3" x-show="showAdvancedFilters" x-transition>
                        <div class="d-flex gap-2 align-items-center">
                            <label class="form-label mb-0">Từ ngày:</label>
                            <input class="form-control" type="date" x-model="fromDate" @@change="load()" style="max-width:180px" />
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <label class="form-label mb-0">Đến ngày:</label>
                            <input class="form-control" type="date" x-model="toDate" @@change="load()" style="max-width:180px" />
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <label class="form-label mb-0">Giá từ:</label>
                            <input class="form-control" type="number" x-model="minPrice" placeholder="0" @@input.debounce.500ms="load()" style="max-width:150px" />
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <label class="form-label mb-0">Giá đến:</label>
                            <input class="form-control" type="number" x-model="maxPrice" placeholder="999999999" @@input.debounce.500ms="load()" style="max-width:150px" />
                        </div>
                        <button class="btn btn-sm btn-outline-danger" @@click="clearAdvancedFilters()">
                            <i class="bi bi-x-circle"></i> Xóa bộ lọc
                        </button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-centered table-hover text-nowrap table-borderless mb-0 table-with-checkbox">
                        <thead class="bg-light">
                            <tr>
                                <th>@ViewBag.OrderId</th>
                                <th>Code</th>
                                <th>@ViewBag.UserEmail</th>
                                <th>@ViewBag.UserPhone</th>
                                <th>@ViewBag.OrderTotal</th>
                                <th>@ViewBag.OrderPayment</th>
                                <th>@ViewBag.OrderStatus</th>
                                <th>@ViewBag.OrderDate</th>
                                <th>@ViewBag.Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <template x-if="loading"><tr><td colspan="9" class="text-center py-4">Loading...</td></tr></template>
                            <template x-for="o in items" :key="o.id">
                                <tr>
                                    <td x-text="o.id"></td>
                                    <td x-text="o.code"></td>
                                    <td x-text="o.email"></td>
                                    <td x-text="o.phone || '-' "></td>
                                    <td x-text="formatPrice(o.totalPrice)"></td>
                                    <td><span class="badge" :class="paymentBadge(o.paymentStatus)" x-text="paymentText(o.paymentStatus)"></span></td>
                                    <td><span class="badge" :class="statusBadge(o.status)" x-text="statusText(o.status)"></span></td>
                                    <td x-text="formatDate(o.createdAt)"></td>
                                    <td>
                                        <div class="dropdown">
                                            <a href="#" class="text-reset" data-bs-toggle="dropdown"><i class="feather-icon icon-more-vertical fs-5"></i></a>
                                            <ul class="dropdown-menu">
                                                <li><a class="dropdown-item" :href="`/admin/OrderDetail?id=${o.id}`"><i class="bi bi-eye me-3"></i>@ViewBag.View</a></li>
                                                <li><hr class="dropdown-divider" /></li>
                                                <li class="dropdown-header">Cập nhật trạng thái</li>
                                                <li><a class="dropdown-item" href="#" x-on:click.prevent="updateStatus(o,1)"><span class="badge bg-light-primary text-dark-primary me-2">Chờ tài xế</span></a></li>
                                                <li><a class="dropdown-item" href="#" x-on:click.prevent="updateStatus(o,2)"><span class="badge bg-light-primary text-dark-primary me-2">Đang lấy hàng</span></a></li>
                                                <li><a class="dropdown-item" href="#" x-on:click.prevent="updateStatus(o,3)"><span class="badge bg-light-success text-dark-success me-2">Đang giao hàng</span></a></li>
                                                <li><a class="dropdown-item" href="#" x-on:click.prevent="updateStatus(o,4)"><span class="badge bg-light-danger text-dark-danger me-2">Đã hủy</span></a></li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
                <div class="border-top d-md-flex justify-content-between align-items-center p-6">
                    <span x-text="`Hiển thị ${items.length} / ${total} đơn hàng (Trang ${page}/${totalPages})`"></span>
                    <nav class="mt-2 mt-md-0" x-show="totalPages > 1">
                        <ul class="pagination mb-0">
                            <li class="page-item" :class="{disabled: page === 1}">
                                <a class="page-link" href="#" @@click.prevent="page = 1; load()">Đầu</a>
                            </li>
                            <li class="page-item" :class="{disabled: page === 1}">
                                <a class="page-link" href="#" @@click.prevent="page--; load()">Trước</a>
                            </li>
                            <template x-for="p in getPageNumbers()" :key="p">
                                <li class="page-item" :class="{active: page === p}">
                                    <a class="page-link" href="#" @@click.prevent="page = p; load()" x-text="p"></a>
                                </li>
                            </template>
                            <li class="page-item" :class="{disabled: page === totalPages}">
                                <a class="page-link" href="#" @@click.prevent="page++; load()">Sau</a>
                            </li>
                            <li class="page-item" :class="{disabled: page === totalPages}">
                                <a class="page-link" href="#" @@click.prevent="page = totalPages; load()">Cuối</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
            <script>
            function ordersAdmin(){
              return {
                items:[], loading:false, error:false, 
                search:'', status:'', paymentMethod:'', 
                fromDate:'', toDate:'', minPrice:'', maxPrice:'',
                page:1, pageSize:20, total:0, totalPages:0,
                showAdvancedFilters:false,
                stats:null,
                connection:null,
                
                init(){ this.load(); this.loadStatistics(); this.initHub(); },
                
                formatPrice(v){ try{ return new Intl.NumberFormat('vi-VN', {style:'currency', currency:'VND'}).format(v); }catch{ return String(v); } },
                formatDate(s){ try{ return new Date(s).toLocaleString('vi-VN'); }catch{ return s; } },
                paymentText(p){ return p===1? 'Paid' : (p===2? 'Refunded' : 'Unpaid'); },
                paymentBadge(p){ return p===1? 'bg-light-primary text-dark-primary' : (p===2? 'bg-light-warning text-dark-warning' : 'bg-light-secondary text-dark'); },
                statusText(st){ switch(st){ case 0: return 'Pending'; case 1: return 'Processing'; case 2: return 'Shipped'; case 3: return 'Delivered'; case 4: return 'Cancelled'; default: return String(st);} },
                statusBadge(st){ switch(st){ case 0: return 'bg-light-warning text-dark-warning'; case 3: return 'bg-light-success text-dark-success'; case 4: return 'bg-light-danger text-dark-danger'; default: return 'bg-light-primary text-dark-primary'; } },
                
                async load(){ 
                  this.loading=true; 
                  this.error=false; 
                  try{ 
                    const token = localStorage.getItem('token') || localStorage.getItem('auth_token');
                    const u=new URL('/api/orders', window.location.origin); 
                    if(this.search) u.searchParams.set('search', this.search); 
                    if(this.status!=='') u.searchParams.set('status', this.status);
                    if(this.paymentMethod) u.searchParams.set('paymentMethod', this.paymentMethod);
                    if(this.fromDate) u.searchParams.set('fromDate', this.fromDate);
                    if(this.toDate) u.searchParams.set('toDate', this.toDate);
                    if(this.minPrice) u.searchParams.set('minPrice', this.minPrice);
                    if(this.maxPrice) u.searchParams.set('maxPrice', this.maxPrice);
                    u.searchParams.set('page', this.page);
                    u.searchParams.set('pageSize', this.pageSize);
                    
                    const r=await fetch(u, {
                      headers: token ? { 'Authorization': 'Bearer ' + token } : {}
                    }); 
                    if(!r.ok) {
                      if(r.status === 403) {
                        alert('Bạn không có quyền truy cập. Vui lòng đăng nhập lại.');
                        window.location.href = '/auth/SignIn';
                        return;
                      }
                      throw new Error(`HTTP ${r.status}`);
                    }
                    const j=await r.json(); 
                    this.items=j.data||[]; 
                    this.total=j.total||0;
                    this.totalPages=Math.ceil(this.total/this.pageSize)||1;
                  }catch(e){ 
                    this.error=true; 
                    console.error('Load orders error:', e);
                  } finally{ 
                    this.loading=false; 
                  } 
                },
                
                getPageNumbers(){
                  const pages = [];
                  const maxPages = 5; // Hiển thị tối đa 5 số trang
                  let start = Math.max(1, this.page - Math.floor(maxPages/2));
                  let end = Math.min(this.totalPages, start + maxPages - 1);
                  if(end - start < maxPages - 1) {
                    start = Math.max(1, end - maxPages + 1);
                  }
                  for(let i = start; i <= end; i++) {
                    pages.push(i);
                  }
                  return pages;
                },
                
                toggleAdvancedFilters(){
                  this.showAdvancedFilters = !this.showAdvancedFilters;
                },
                
                clearAdvancedFilters(){
                  this.fromDate = '';
                  this.toDate = '';
                  this.minPrice = '';
                  this.maxPrice = '';
                  this.load();
                },
                
                async loadStatistics(){
                  try{
                    const token = localStorage.getItem('token') || localStorage.getItem('auth_token');
                    const r = await fetch('/api/orders/statistics', {
                      headers: token ? { 'Authorization': 'Bearer ' + token } : {}
                    });
                    if(r.ok){
                      const j = await r.json();
                      this.stats = j;
                    } else if(r.status === 403) {
                      console.warn('No permission to load statistics');
                    }
                  }catch(e){
                    console.error('Load statistics error:', e);
                  }
                },
                
                async exportOrders(format){
                  try{
                    const token = localStorage.getItem('token') || localStorage.getItem('auth_token');
                    const u = new URL('/api/orders/export', window.location.origin);
                    if(this.search) u.searchParams.set('search', this.search);
                    if(this.status !== '') u.searchParams.set('status', this.status);
                    if(this.paymentMethod) u.searchParams.set('paymentMethod', this.paymentMethod);
                    if(this.fromDate) u.searchParams.set('fromDate', this.fromDate);
                    if(this.toDate) u.searchParams.set('toDate', this.toDate);
                    if(this.minPrice) u.searchParams.set('minPrice', this.minPrice);
                    if(this.maxPrice) u.searchParams.set('maxPrice', this.maxPrice);
                    u.searchParams.set('format', format);
                    
                    const r = await fetch(u, {
                      headers: token ? { 'Authorization': 'Bearer ' + token } : {}
                    });
                    if(r.ok){
                      const blob = await r.blob();
                      const url = window.URL.createObjectURL(blob);
                      const a = document.createElement('a');
                      a.href = url;
                      a.download = `orders_export_${new Date().toISOString().slice(0,10)}.${format === 'csv' ? 'csv' : 'xlsx'}`;
                      document.body.appendChild(a);
                      a.click();
                      window.URL.revokeObjectURL(url);
                      document.body.removeChild(a);
                    } else {
                      alert('Xuất file thất bại');
                    }
                  }catch(e){
                    console.error('Export error:', e);
                    alert('Lỗi khi xuất file: ' + e.message);
                  }
                },
                
                async updateStatus(order, st){ 
                  try{ 
                    const token = localStorage.getItem('token') || localStorage.getItem('auth_token');
                    const note = prompt('Ghi chú (tuỳ chọn):',''); 
                    const r = await fetch(`/api/orders/${order.id}/status`, { 
                      method:'PATCH', 
                      headers:{
                        'Content-Type':'application/json',
                        ...(token ? { 'Authorization': 'Bearer ' + token } : {})
                      }, 
                      body: JSON.stringify({ status: st, note }) 
                    }); 
                    if(r.ok){ 
                      await this.load(); 
                      await this.loadStatistics(); // Refresh statistics after status update
                    } else { 
                      const j=await r.json().catch(()=>({})); 
                      alert(j.message||'Cập nhật trạng thái thất bại'); 
                    } 
                  } catch(e){ 
                    alert('Lỗi kết nối máy chủ'); 
                  } 
                },
                
                async initHub(){ 
                  try { 
                    if(window.signalR){ 
                      this.connection = new signalR.HubConnectionBuilder()
                        .withUrl('/hubs/order')
                        .withAutomaticReconnect()
                        .build(); 
                      this.connection.on('OrderUpdated', (orderId, status)=>{ 
                        this.load(); 
                      }); 
                      await this.connection.start(); 
                    } 
                  } catch(e){ 
                    console.warn('Order hub init failed', e); 
                  }
                }
              }
            }
            </script>
</div>
<!-- row -->
<div class="row">
	<div class="col-xl-12 col-12 mb-5">
		<!-- card -->
		<div class="card h-100 card-lg">
			<div class="p-6">
				<div class="row justify-content-between">
					<div class="col-md-4 col-12 mb-2 mb-md-0">
						<!-- form -->
						<form class="d-flex" role="search">
							<input class="form-control" type="search" placeholder="Search" aria-label="Search" />
						</form>
					</div>
					<div class="col-lg-2 col-md-4 col-12">
						<!-- select -->
						<select class="form-select">
							<option selected>@ViewBag.OrderStatus</option>
							<option value="Success">Success</option>
							<option value="Pending">@ViewBag.OrderPending</option>
							<option value="Cancel">Cancel</option>
						</select>
					</div>
				</div>
			</div>
            <!-- card body (static placeholder, hidden) -->
            <div class="card-body p-0" style="display:none">
				<!-- table responsive -->
				<div class="table-responsive">
					<table
						class="table table-centered table-hover text-nowrap table-borderless mb-0 table-with-checkbox">
						<thead class="bg-light">
							<tr>
								<th>
									<div class="form-check">
										<input class="form-check-input" type="checkbox" value id="checkAll" />
										<label class="form-check-label" for="checkAll"></label>
									</div>
								</th>
								<th>Image</th>
								<th>Order Name</th>
								<th>@ViewBag.OrderUser</th>
								<th>Date & TIme</th>
								<th>@ViewBag.OrderPayment</th>
								<th>@ViewBag.OrderStatus</th>
								<th>Amount</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>
									<div class="form-check">
										<input class="form-check-input" type="checkbox" value id="orderOne" />
										<label class="form-check-label" for="orderOne"></label>
									</div>
								</td>
								<td>
									<a href="#!"><img src="../assets/images/products/product-img-1.jpg" alt
											class="icon-shape icon-md" /></a>
								</td>
								<td><a href="#" class="text-reset">FC#1007</a></td>
								<td>Jennifer Sullivan</td>

								<td>01 May 2023 (10:12 am)</td>
								<td>Paypal</td>

								<td>
									<span class="badge bg-light-primary text-dark-primary">Success</span>
								</td>
								<td>$12.99</td>

								<td>
									<div class="dropdown">
										<a href="#" class="text-reset" data-bs-toggle="dropdown" aria-expanded="false">
											<i class="feather-icon icon-more-vertical fs-5"></i>
										</a>
										<ul class="dropdown-menu">
											<li>
												<a class="dropdown-item" href="#">
													<i class="bi bi-trash me-3"></i>
													Delete
												</a>
											</li>
											<li>
												<a class="dropdown-item" href="@Url.Action("OrderDetail", "Admin")">
													<i class="bi bi-eye me-3"></i>
													View
												</a>
											</li>
										</ul>
									</div>
								</td>
							</tr>
							<tr>
								<td>
									<div class="form-check">
										<input class="form-check-input" type="checkbox" value id="orderTwo" />
										<label class="form-check-label" for="orderTwo"></label>
									</div>
								</td>
